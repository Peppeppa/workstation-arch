-- Managed by Ansible (roles/hyprland/templates/conf/appearance.lua.j2) - do not
-- edit by hand. Loaded by ~/.config/hypr/hyprland.lua.
--
-- Performance defaults: instant interaction over decorative effects
-- (docs/ARCHITECTURE.md) - animations, blur and shadows are off.
--
-- Window border colors come from the active theme: the `theme` helper
-- (roles/theme) renders them into the user's runtime theme dir; a theme
-- switch rewrites that file and runs `hyprctl reload`. pcall: if it's
-- missing, Hyprland keeps its default colors (no config error).
return function(v)
    local theme_ok, theme = pcall(dofile, v.userDir .. "/.config/workstation/theme/hyprland.lua")

    hl.config({
        -- Window geometry (RICE v1, docs/DESIGN_SYSTEM.md "Windows"): small
        -- gaps on the Style spacing scale (gaps_in is per side: 2 x {{ hyprland_gaps_in }}
        -- between two windows), a 1 px border, the control radius.
        -- border_active = focused window, border = the rest (theme roles).
        general = {
            gaps_in = {{ hyprland_gaps_in }},
            gaps_out = {{ hyprland_gaps_out }},
            border_size = {{ hyprland_border_size }},
            col = theme_ok and {
                active_border   = theme.border_active,
                inactive_border = theme.border,
            } or nil,
        },

        animations = {
            enabled = false,
        },

        decoration = {
            rounding = {{ hyprland_rounding }},
            shadow = { enabled = false },
            blur   = { enabled = false },
        },
{% if lock_idle_enabled or wallpaper_enabled %}

        misc = {
{% if lock_idle_enabled %}
            -- FEATURE: lock_idle. If the locker (hyprlock) ever crashes, the
            -- session stays locked; this lets a fresh locker take over
            -- instead of leaving only a TTY switch. Never unlocks anything.
            allow_session_lock_restore = true,
{% endif %}
{% if wallpaper_enabled %}
            -- FEATURE: wallpaper. Quickshell draws the background layer;
            -- Hyprland's own default wallpaper/logo would only be decoded
            -- underneath for nothing.
            force_default_wallpaper = 0,
            disable_hyprland_logo = true,
{% endif %}
        },
{% endif %}
    })

    -- Quickshell's scratchpad (roles/quickshell scratchpad/): a small
    -- floating note window at the top right, below the bar, on every
    -- workspace. 48 px clears the bar up to the largest text size.
    hl.window_rule({
        match = { title = "^workstation-scratchpad$" },
        float = true,
        pin = true,
        move = { "(monitor_w-window_w-12)", "48" },
    })

    -- Quickshell's cheatsheet (roles/quickshell cheatsheet/, mainMod+T): a
    -- floating viewer centered on the focused output; its size comes from
    -- the window itself (kept inside the output).
    hl.window_rule({
        match = { title = "^workstation-cheatsheet$" },
        float = true,
        center = true,
    })
end
