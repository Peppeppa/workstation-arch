# Managed by Ansible (roles/hyprland/templates/config.ghostty.j2) - do not
# edit by hand. Font from group_vars/all.yml desktop_monospace_font_family;
# everything else stays Ghostty's default except the settings below.
font-family = {{ desktop_monospace_font_family }}

# Close a window without asking, even with a running process (the user's
# choice; Super+Q closes the focused window).
confirm-close-surface = false

# Colors (background, foreground, cursor, selection, ANSI 0-15) of the
# active theme, generated by the `theme` helper (roles/theme) - never
# rendered here. `?`: a missing file is not an error (Ghostty defaults).
# On a theme switch the helper rewrites it and sends Ghostty SIGUSR2,
# which reloads the configuration of every open window.
config-file = ?{{ ansible_facts.user_dir }}/.config/workstation/theme/ghostty
