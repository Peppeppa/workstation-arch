-- Minimal-usable-daily-driver Hyprland session config - managed by
-- Ansible. Do not edit by hand: see roles/hyprland in workstation-arch.
--
-- No bar or wallpaper yet - Quickshell is a later, separate
-- presentation layer. See docs/ARCHITECTURE.md for the intended stack.
--
-- Current Hyprland (0.55+) reads ~/.config/hypr/hyprland.lua, not the
-- older hyprlang hyprland.conf format - verified against Hyprland's own
-- config path resolution and the official example config, not an old
-- blog post.

-- scale is "auto" on real hardware (laptop/workstation report real
-- physical monitor dimensions, so Hyprland's auto-scale heuristic picks
-- the right value) - configurable per host (see hyprland_monitor_scale
-- in roles/hyprland/defaults/main.yml) because arch-dev's VirtualBox
-- virtual display reports physicalWidth/physicalHeight as 0, which
-- makes "auto" pick scale 2 for a 1280x800 output instead of 1 (real
-- VM testing: `hyprctl monitors -j` showed physicalWidth/Height: 0 and
-- scale: 2) - see host_vars/arch-dev.yml.
hl.monitor({
    output   = "",
    mode     = "preferred",
    position = "auto",
{%- if hyprland_monitor_scale == "auto" %}
    scale    = "auto",
{%- else %}
    scale    = {{ hyprland_monitor_scale }},
{%- endif %}
})

local terminal = "{{ hyprland_terminal }}"
local launcher = "{{ hyprland_launcher }}"

-- Main modifier for every keybind below - configurable per host (see
-- hyprland_main_modifier in roles/hyprland/defaults/main.yml), SUPER on
-- real target hosts. Kept as one local, like Hyprland's own official
-- example config does, so a host override changes exactly one value.
local mainMod = "{{ hyprland_main_modifier }}"

-- Performance defaults: this project targets instant interaction over
-- decorative effects (see docs/ARCHITECTURE.md), so animations and
-- blur/shadow are off from the start rather than tuned down later.
hl.config({
    animations = {
        enabled = false,
    },

    decoration = {
        shadow = { enabled = false },
        blur   = { enabled = false },
    },
})

-------------------
---- AUTOSTART ----
-------------------

-- Session-lifecycle helpers that Hyprland itself must start exactly
-- once (see docs/ARCHITECTURE.md "one owner per responsibility" - not
-- also a systemd user service or shell-startup hook for the same
-- process). Their packages come from roles/desktop, not this role.
-- xdg-desktop-portal* is NOT started here: those are D-Bus-activated
-- systemd --user services shipped by their own packages and need no
-- autostart entry.
--
-- mako (notifications) is TEMPORARY UNTIL QUICKSHELL REPLACEMENT.
hl.on("hyprland.start", function()
    hl.exec_cmd("hyprpolkitagent")
    hl.exec_cmd("mako")
end)

---------------------
---- KEYBINDINGS ----
---------------------

-- Minimal but genuinely usable keybind set - not final Quickshell/UX
-- polish, see README.md. All bound on mainMod, not a hardcoded
-- modifier, so a host override (see hyprland_main_modifier) changes
-- every bind below, not just some of them.
hl.bind(mainMod .. " + Return", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + Q", hl.dsp.window.close())
hl.bind(mainMod .. " + SHIFT + E", hl.dsp.exit())

-- Temporary launcher (see hyprland_packages / TEMPORARY note above).
hl.bind(mainMod .. " + Space", hl.dsp.exec_cmd(launcher))

-- Move keyboard focus between windows.
hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down" }))

-- Move/resize floating windows with the mouse.
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Switch workspaces with mainMod + [1-9]; move the active window to a
-- workspace with mainMod + SHIFT + [1-9].
for i = 1, 9 do
    hl.bind(mainMod .. " + " .. i,         hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. i, hl.dsp.window.move({ workspace = i }))
end

-- Region screenshot -> clipboard (select a region, then paste directly
-- into a browser/chat). grim/slurp/wl-clipboard come from roles/desktop.
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.exec_cmd('grim -g "$(slurp)" - | wl-copy'))

-- Full-screen screenshot -> clipboard. Not on mainMod - a physical key,
-- unaffected by the main-modifier override.
hl.bind("Print", hl.dsp.exec_cmd("grim - | wl-copy"))
