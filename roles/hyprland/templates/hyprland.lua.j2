-- Hyprland session config entry point - managed by Ansible (roles/hyprland/
-- templates/hyprland.lua.j2). Do not edit by hand.
--
-- Current Hyprland (0.55+) reads ~/.config/hypr/hyprland.lua (Lua, not the
-- older hyprlang hyprland.conf). This file only loads the modules in
-- ~/.config/hypr/conf/, each a function taking the shared values:
--   vars.lua        shared values (terminal, main modifier, home dir)
--   monitors.lua    monitor foundation (hyprland_monitors)
--   input.lua       keyboard layout
--   appearance.lua  borders (active theme), animations/blur/shadow, misc
--   session.lua     processes Hyprland owns (polkit agent, Quickshell, hypridle)
--   binds.lua       keybindings incl. hardware keys
--   rules.lua       window rules for apps Hyprland would mis-place (Zoom)
-- Quickshell (roles/quickshell) is the separate presentation layer.
local conf = "{{ ansible_facts.user_dir }}/.config/hypr/conf/"
local v = dofile(conf .. "vars.lua")

for _, module in ipairs({ "monitors", "input", "appearance", "session", "binds", "rules" }) do
    dofile(conf .. module .. ".lua")(v)
end
