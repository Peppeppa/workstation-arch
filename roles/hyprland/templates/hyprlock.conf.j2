# FEATURE: lock_idle (group_vars/all.yml lock_idle_enabled). Managed by
# Ansible from roles/hyprland/templates/hyprlock.conf.j2 - do not edit by
# hand.
#
# Deliberately minimal lockscreen: time, date, password field. No
# wallpaper/screenshot, blur, animations or widgets. Authentication is
# hyprlock's own PAM path (/etc/pam.d/hyprlock from the package ->
# `auth include login`); nothing here touches credentials.

# --- Colors -------------------------------------------------------------
# The only color decisions for the lockscreen, mirroring the Quickshell
# scheme roles/quickshell/files/quickshell/DefaultDark.qml by hand
# (hyprlock can't read QML). Once a theme switcher exists these should be
# generated from the one system-wide scheme (see docs/DESIGN_SYSTEM.md
# "Later") - keep them here, not inline below.
$background = rgb(1e1e1e)
$surface    = rgb(171717)
$text       = rgb(e0e0e0)
$textMuted  = rgba(e0e0e0b3)
$accent     = rgb(3a6ea5)
$error      = rgb(d9534f)
# ------------------------------------------------------------------------

# Shell font (group_vars/all.yml desktop_shell_font_family)
$font = {{ desktop_shell_font_family }}

general {
    hide_cursor = false
    ignore_empty_input = true
}

animations {
    enabled = false
}

background {
    monitor =
    color = $background
}

# TIME (built-in $TIME, no command)
label {
    monitor =
    text = $TIME
    color = $text
    font_family = $font
    font_size = 72
    position = 0, 160
    halign = center
    valign = center
}

# DATE - hyprlock has no date variable; this runs `date` once a minute,
# and only while locked.
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d. %B %Y"
    color = $textMuted
    font_family = $font
    font_size = 18
    position = 0, 80
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 48
    rounding = 6
    outline_thickness = 2
    outer_color = $accent
    inner_color = $surface
    font_color = $text
    font_family = $font
    check_color = $accent
    fail_color = $error
    fade_on_empty = false
    placeholder_text = Password
    fail_text = $PAMFAIL
    position = 0, -20
    halign = center
    valign = center
}
