# FEATURE: lock_idle (group_vars/all.yml lock_idle_enabled). Managed by
# Ansible from roles/hyprland/templates/hyprlock.conf.j2 - do not edit by
# hand.
#
# Deliberately minimal lockscreen: time, date, password field. No
# wallpaper/screenshot, blur, animations or widgets. Authentication is
# hyprlock's own PAM path (/etc/pam.d/hyprlock from the package ->
# `auth include login`); nothing here touches credentials.

# --- Colors -------------------------------------------------------------
# Generated from the active theme (roles/theme: themes/{{ theme_active }}.yml)
# - the same semantic roles Quickshell's Colors.qml uses. Only referenced
# below through these variables.
{% macro rgb(hex) %}rgb({{ hex | regex_replace('^#', '') }}){% endmacro %}
$background       = {{ rgb(theme_colors.background) }}
$surface          = {{ rgb(theme_colors.surface) }}
$foreground       = {{ rgb(theme_colors.foreground) }}
$foreground_muted = {{ rgb(theme_colors.foreground_muted) }}
$accent           = {{ rgb(theme_colors.accent) }}
$border_active    = {{ rgb(theme_colors.border_active) }}
$error            = {{ rgb(theme_colors.error) }}
# ------------------------------------------------------------------------

# Shell font (group_vars/all.yml desktop_shell_font_family)
$font = {{ desktop_shell_font_family }}

general {
    hide_cursor = false
    ignore_empty_input = true
}

animations {
    enabled = false
}

background {
    monitor =
    color = $background
}

# TIME (built-in $TIME, no command)
label {
    monitor =
    text = $TIME
    color = $foreground
    font_family = $font
    font_size = 72
    position = 0, 160
    halign = center
    valign = center
}

# DATE - hyprlock has no date variable; this runs `date` once a minute,
# and only while locked.
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d. %B %Y"
    color = $foreground_muted
    font_family = $font
    font_size = 18
    position = 0, 80
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 48
    rounding = 6
    outline_thickness = 2
    outer_color = $border_active
    inner_color = $surface
    font_color = $foreground
    font_family = $font
    check_color = $accent
    fail_color = $error
    fade_on_empty = false
    placeholder_text = Password
    fail_text = $PAMFAIL
    position = 0, -20
    halign = center
    valign = center
}
