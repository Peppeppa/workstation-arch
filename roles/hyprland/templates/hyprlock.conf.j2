# FEATURE: lock_idle (group_vars/all.yml lock_idle_enabled). Managed by
# Ansible from roles/hyprland/templates/hyprlock.conf.j2 - do not edit by
# hand.
#
# Deliberately minimal lockscreen: time, date, password field. No
# wallpaper/screenshot, blur, animations or widgets. Authentication is
# hyprlock's own PAM path (/etc/pam.d/hyprlock from the package ->
# `auth include login`); nothing here touches credentials.

# --- Colors -------------------------------------------------------------
# $background, $surface, $foreground, $foreground_muted, $accent,
# $accent_foreground, $border, $border_active, $error - the active theme's
# semantic roles, generated by the `theme` helper (roles/theme). Read at
# every lock, so a theme switch applies to the next lock with no restart.
source = {{ ansible_facts.user_dir }}/.config/workstation/theme/hyprlock.conf
# ------------------------------------------------------------------------

# Shell font (group_vars/all.yml desktop_shell_font_family)
$font = {{ desktop_shell_font_family }}

general {
    hide_cursor = false
    ignore_empty_input = true
}

animations {
    enabled = false
}

background {
    monitor =
    color = $background
}

# TIME (built-in $TIME, no command)
label {
    monitor =
    text = $TIME
    color = $foreground
    font_family = $font
    font_size = 72
    position = 0, 160
    halign = center
    valign = center
}

# DATE - hyprlock has no date variable; this runs `date` once a minute,
# and only while locked.
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d. %B %Y"
    color = $foreground_muted
    font_family = $font
    font_size = 18
    position = 0, 80
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 48
    rounding = 6
    outline_thickness = 2
    outer_color = $border_active
    inner_color = $surface
    font_color = $foreground
    font_family = $font
    check_color = $accent
    fail_color = $error
    fade_on_empty = false
    placeholder_text = Password
    fail_text = $PAMFAIL
    position = 0, -20
    halign = center
    valign = center
}
