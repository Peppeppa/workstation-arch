<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  Managed by Ansible (roles/desktop/templates/50-workstation-fonts.conf.j2,
  names from group_vars/all.yml desktop_font_family*) - do not edit by hand.
  User-level drop-in: makes the system font the default for anything that
  asks fontconfig for a generic family (Qt incl. Quickshell, GTK fallback,
  hyprlock, ...). Apps with their own explicit font settings and web page
  fonts are deliberately not overridden. Serif is left alone (documents).
-->
<fontconfig>
  <alias binding="same">
    <family>sans-serif</family>
    <prefer><family>{{ desktop_font_family }}</family></prefer>
  </alias>
  <alias binding="same">
    <family>monospace</family>
    <prefer><family>{{ desktop_font_family_mono }}</family></prefer>
  </alias>
</fontconfig>
