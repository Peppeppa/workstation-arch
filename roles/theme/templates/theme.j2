#!/usr/bin/env python3
# Managed by Ansible (roles/theme/templates/theme.j2) - do not edit by hand.
#
# `theme` - the ONE implementation of the theme system (see
# docs/DESIGN_SYSTEM.md "Themes"): discovery, contract validation,
# rendering of every consumer's color file, the persistent user state and
# applying it live. Ansible provisions by calling `theme validate` and
# `theme apply`; the Quickshell bar calls `theme status|toggle|select`.
# Nothing else renders theme colors.
#
# On-demand only: runs, does its work, exits. No daemon, no watcher.
#
#   theme status [--json]          state + valid dark/light themes (+ invalid ones)
#   theme list dark|light          valid theme ids of that mode, one per line
#   theme current                  dark=<id> light=<id> mode=<mode>
#   theme toggle                   flip mode, apply
#   theme mode dark|light          set mode, apply
#   theme select dark|light <id>   pick the dark/light theme; applied only if that
#                                  mode is active (never switches the mode)
#   theme apply [--init-dark ID --init-light ID --init-mode MODE]
#                                  (re)render + apply the current state; creates
#                                  the state from the --init-* values only if it
#                                  does not exist yet. Prints changed/unchanged.
#   theme validate                 check every theme directory, exit 1 if any is invalid
#   theme wallpaper list           JSON: the active theme's backgrounds + the one in use
#   theme wallpaper set <file>     use backgrounds/<file> for the active theme (remembered
#                                  per theme), apply
#   theme text-size [<px>]         print / set the desktop text size (one of
#                                  TEXT_SIZES), apply
#   theme import <url> dark|light  clone an Omarchy theme repository (pinned to its
#                                  current commit), compile it, add it to the manifest
#   theme remove <id>              remove an imported theme (never the selected
#                                  dark/light theme, never a bundled one)
#   theme sync-sources             provisioning: every manifest entry present at its
#                                  pinned commit and compiled. Prints changed/unchanged.
#
# Theme registry = the theme directories themselves (no list anywhere else):
#   <THEMES_DIR>/<id>/{dark|light, theme.yml, backgrounds/}      bundled (the repo)
#   <COMPILED_DIR>/<id>/{dark|light, theme.yml, backgrounds/...}  imported (user data)
# A theme id may live in both (a bundled theme associated with its source
# repository): the bundled theme.yml and marker win (curated palette), the
# compiled directory adds the source's backgrounds and app payloads.
#
# Theme sources (THEMES_DIR/sources.yml, the manifest): Omarchy theme
# repositories pinned to an exact commit. They are UNTRUSTED DATA: cloned
# with hooks, submodules, symlinks, filters, credential helpers and every
# non-https protocol off, then only known files are READ and parsed
# (colors.toml / alacritty.toml / ghostty.conf / hyprland.conf palettes,
# neovim.lua as text, btop.theme line by line, backgrounds/ referenced) -
# nothing in them is ever executed, sourced or copied as configuration.
# Everything else is listed as ignored in the compiled theme's source.json.
#
# Outputs (~/.config/workstation/theme/): colors.json (Quickshell: colors +
# wallpaper + text size), hyprland.lua, hyprlock.conf, ghostty (colors +
# font size), neovim.lua + neovim-current.lua (Neovim) - each app includes
# its file.
#
# Neovim: a theme MAY name the real Neovim port of itself (theme.yml
# `neovim:` - data only: plugin "owner/repo", optional lazy.nvim name,
# colorscheme). neovim.lua is a lazy.nvim spec with EVERY valid theme's
# plugin (lazy-loaded, so switching never needs a download) and LazyVim's
# colorscheme = a function applying neovim-current.lua (the active theme's
# colorscheme + background); LazyVim's config imports it through
# ~/.config/nvim/lua/plugins/workstation-theme.lua (roles/apps). Running
# Neovims are told explicitly: `doautocmd User WorkstationTheme` over each
# one's own RPC server socket ($XDG_RUNTIME_DIR/nvim.<pid>.*) - no watcher.
#
# Text size: one typography preference for the desktop (state key
# text-size, default = the GTK font size of group_vars desktop_ui_font_size).
# Every consumer derives its own size from it, relative to that default:
# Quickshell scales its sizes (Fonts.px), Ghostty's font-size scales its
# default 12 pt, GTK/libadwaita get text-scaling-factor (GSettings, written
# only here). Neovim inside Ghostty follows Ghostty. Independent of the
# display scale (Hyprland monitor scale).
#
# Wallpapers: the image files in the active theme's backgrounds/ ARE the
# list (no second registry). The choice is remembered per theme in the
# state file (wallpaper.<id>=<file>); without a (still existing) choice the
# first file in sorted order is used; with no files there is no wallpaper
# (Quickshell then shows the theme's background color).

import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import tomllib

import yaml

THEMES_DIR = "{{ theme_dir }}"
MANIFEST = os.path.join(THEMES_DIR, "sources.yml")
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
DATA_HOME = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
SOURCES_DIR = os.path.join(DATA_HOME, "workstation", "themes", "sources")
COMPILED_DIR = os.path.join(DATA_HOME, "workstation", "themes", "compiled")
STATE_FILE = os.path.join(CONFIG_HOME, "workstation", "theme-state")
OUT_DIR = os.path.join(CONFIG_HOME, "workstation", "theme")

MODES = ("dark", "light")
# Semantic color contract - every theme fills exactly these roles.
ROLES = (
    "background", "surface", "foreground", "foreground_strong", "foreground_muted", "accent",
    "accent_foreground", "border", "border_active", "error",
)
# Terminal contract - the 16 ANSI colors (0-15, in this order); every
# theme has them, taken from the theme's own terminal palette.
TERMINAL = (
    "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
    "bright_black", "bright_red", "bright_green", "bright_yellow",
    "bright_blue", "bright_magenta", "bright_cyan", "bright_white",
)
THEME_KEYS = {"name", "colors", "terminal", "neovim"}
NEOVIM_KEYS = {"plugin": True, "name": False, "branch": False, "colorscheme": True,
               "colors": False}   # key: required
BRANCH_RE = re.compile(r"^[A-Za-z0-9._/-]{1,60}$")
COLOR_KEY_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
PLUGIN_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
NAME_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
# Wallpaper formats Quickshell can show (WebP via qt6-imageformats); GIF
# is shown animated.
WALLPAPER_EXT = (".png", ".jpg", ".jpeg", ".webp", ".gif")
ANIMATED_EXT = (".gif",)
TEXT_SIZES = (9, 10, 11, 12, 14, 16, 18)
DEFAULT_TEXT_SIZE = {{ desktop_ui_font_size | default(11) }}
GHOSTTY_DEFAULT_PT = 12      # Ghostty's own default font-size


class ThemeError(Exception):
    pass


# --- discovery / contract --------------------------------------------------

def theme_dirs(theme_id):
    """The directories of one theme id: bundled first, then compiled."""
    return [d for d in (os.path.join(THEMES_DIR, theme_id), os.path.join(COMPILED_DIR, theme_id))
            if os.path.isdir(d)]


def load_theme(theme_id):
    """Return (theme, errors). theme = {id, name, mode, colors} when valid."""
    dirs = theme_dirs(theme_id)
    path = dirs[0] if dirs else os.path.join(THEMES_DIR, theme_id)
    errors = []
    if not ID_RE.match(theme_id):
        errors.append("directory name must match [a-z0-9][a-z0-9-]* (it is the theme id)")
    markers = [m for m in MODES if os.path.isfile(os.path.join(path, m))]
    if len(markers) != 1:
        errors.append("needs exactly one marker file 'dark' or 'light' (found: %s)"
                      % (", ".join(markers) or "none"))
    for other in dirs[1:]:
        if markers and not os.path.isfile(os.path.join(other, markers[0])):
            errors.append("its source was imported with the other mode than its bundled marker")
    if not any(os.path.isdir(os.path.join(d, "backgrounds")) for d in dirs):
        errors.append("missing backgrounds/ directory")
    data = None
    try:
        with open(os.path.join(path, "theme.yml"), encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except FileNotFoundError:
        errors.append("missing theme.yml")
    except yaml.YAMLError as e:
        errors.append("theme.yml is not valid YAML: %s" % str(e).splitlines()[0])
    except (UnicodeDecodeError, OSError) as e:
        # one unreadable theme is an invalid theme, not a crash of discovery
        errors.append("theme.yml is unreadable: %s" % e.__class__.__name__)
    if data is not None:
        if not isinstance(data, dict):
            errors.append("theme.yml must be a mapping")
        else:
            unknown = set(data) - THEME_KEYS
            if unknown:
                errors.append("unknown keys in theme.yml: %s" % ", ".join(sorted(unknown)))
            if not isinstance(data.get("name"), str) or not data.get("name"):
                errors.append("theme.yml needs a non-empty string 'name'")
            for block, keys in (("colors", ROLES), ("terminal", TERMINAL)):
                values = data.get(block)
                if not isinstance(values, dict):
                    errors.append("theme.yml needs a '%s' mapping" % block)
                    continue
                missing = [k for k in keys if k not in values]
                extra = [k for k in values if k not in keys]
                bad = [k for k in keys if k in values
                       and not (isinstance(values[k], str) and HEX_RE.match(values[k]))]
                if missing:
                    errors.append("missing %s: %s" % (block, ", ".join(missing)))
                if extra:
                    errors.append("unknown %s: %s" % (block, ", ".join(extra)))
                if bad:
                    errors.append("%s not #rrggbb: %s" % (block, ", ".join(bad)))
            nvim = data.get("neovim")
            if nvim is not None:
                if not isinstance(nvim, dict):
                    errors.append("theme.yml 'neovim' must be a mapping")
                else:
                    unknown = set(nvim) - set(NEOVIM_KEYS)
                    if unknown:
                        errors.append("unknown neovim keys: %s" % ", ".join(sorted(unknown)))
                    errors += neovim_errors(nvim)
    if errors:
        return None, errors
    nvim = data.get("neovim")
    btop = None
    for d in dirs:
        if nvim is None and d != path:
            nvim = compiled_neovim(d)
        if os.path.isfile(os.path.join(d, "btop.theme")):
            btop = os.path.join(d, "btop.theme")
    return {"id": theme_id, "name": data["name"], "mode": markers[0],
            "colors": {r: data["colors"][r] for r in ROLES},
            "terminal": [data["terminal"][k] for k in TERMINAL],
            "neovim": nvim, "btop": btop, "dirs": dirs}, []


def neovim_errors(nvim):
    """The neovim block's contract - every value ends up in generated Lua,
    so each one is checked against a strict pattern."""
    errors = []
    for k, required in NEOVIM_KEYS.items():
        v = nvim.get(k)
        if v is None:
            if required:
                errors.append("neovim needs '%s'" % k)
            continue
        if k == "colors":
            if not (isinstance(v, dict) and len(v) <= 64 and all(
                    isinstance(c, str) and COLOR_KEY_RE.match(c) and isinstance(h, str) and HEX_RE.match(h)
                    for c, h in v.items())):
                errors.append("neovim colors must map name -> #rrggbb")
            continue
        rx = PLUGIN_RE if k == "plugin" else BRANCH_RE if k == "branch" else NAME_RE
        if not (isinstance(v, str) and rx.match(v)):
            errors.append("neovim %s must match %s" % (k, rx.pattern))
    return errors


def compiled_neovim(directory):
    """The neovim block of a compiled theme.yml (a bundled theme without
    its own block takes the one its source provided)."""
    try:
        with open(os.path.join(directory, "theme.yml"), encoding="utf-8") as f:
            data = yaml.safe_load(f) or {}
    except (OSError, yaml.YAMLError, UnicodeDecodeError):
        return None
    n = data.get("neovim") if isinstance(data, dict) else None
    if not isinstance(n, dict):
        return None
    n = {k: v for k, v in n.items() if k in NEOVIM_KEYS}
    return n if not neovim_errors(n) else None


def discover():
    """Scan the theme directories once. Returns (valid {id: theme}, invalid {id: errors})."""
    valid, invalid = {}, {}
    try:
        entries = set(os.listdir(THEMES_DIR))
    except FileNotFoundError:
        raise ThemeError("theme directory %s does not exist" % THEMES_DIR)
    try:
        entries |= set(os.listdir(COMPILED_DIR))
    except FileNotFoundError:
        pass
    for entry in sorted(entries):
        if entry.startswith(".") or not theme_dirs(entry):
            continue
        theme, errors = load_theme(entry)
        if theme:
            valid[entry] = theme
        else:
            invalid[entry] = errors
    return valid, invalid


# --- state -----------------------------------------------------------------

def read_state():
    # errors="replace": a corrupted byte must not crash every command (it
    # did - UnicodeDecodeError traceback); the damaged value then simply
    # fails check_state() like any other invalid entry.
    try:
        with open(STATE_FILE, encoding="utf-8", errors="replace") as f:
            pairs = dict(line.rstrip("\n").split("=", 1) for line in f if "=" in line)
    except FileNotFoundError:
        return None
    state = {k: pairs.get(k, "") for k in ("dark", "light", "mode")}
    state["wallpapers"] = {k[len("wallpaper."):]: v for k, v in pairs.items()
                           if k.startswith("wallpaper.") and v}
    # a state written before text sizes existed: the default
    state["text_size"] = pairs.get("text-size", str(DEFAULT_TEXT_SIZE))
    return state


def background_paths(theme_id):
    """{file name: path} of the theme's wallpapers: its bundled backgrounds/
    first, then the ones its source provides (a name already taken keeps
    the bundled file)."""
    found = {}
    for d in theme_dirs(theme_id):
        path = os.path.join(d, "backgrounds")
        try:
            names = os.listdir(path)
        except (FileNotFoundError, NotADirectoryError):
            continue
        for n in names:
            if (n not in found and not n.startswith(".") and n.lower().endswith(WALLPAPER_EXT)
                    and os.path.isfile(os.path.join(path, n))):
                found[n] = os.path.join(path, n)
    return found


def backgrounds(theme_id):
    """The theme's wallpaper files (names), sorted - the deterministic order."""
    return sorted(background_paths(theme_id))


def wallpaper(state, theme_id):
    """The wallpaper in use for a theme: the remembered choice if it still
    exists, else the first file, else None."""
    files = backgrounds(theme_id)
    choice = state.get("wallpapers", {}).get(theme_id)
    name = choice if choice in files else (files[0] if files else None)
    if name is None:
        return None
    return {"file": name, "path": background_paths(theme_id)[name],
            "animated": name.lower().endswith(ANIMATED_EXT)}


def wallpaper_list(state):
    tid = state[state["mode"]]
    current = wallpaper(state, tid)
    paths = background_paths(tid)
    return {"theme": tid, "selected": current["file"] if current else None,
            "backgrounds": [{"file": n, "path": paths[n], "animated": n.lower().endswith(ANIMATED_EXT)}
                            for n in sorted(paths)]}


def text_size(state):
    try:
        v = int(state.get("text_size", DEFAULT_TEXT_SIZE))
    except (TypeError, ValueError):
        return None
    return v if v in TEXT_SIZES else None


def check_state(state, valid):
    if text_size(state) is None:
        raise ThemeError("text-size must be one of %s, not %r"
                         % (" ".join(map(str, TEXT_SIZES)), state.get("text_size")))
    if state["mode"] not in MODES:
        raise ThemeError("mode must be dark or light, not %r" % state["mode"])
    for slot in MODES:
        theme = valid.get(state[slot])
        if theme is None:
            raise ThemeError("%s theme %r is not a valid theme" % (slot, state[slot]))
        if theme["mode"] != slot:
            raise ThemeError("%r is a %s theme, not %s" % (state[slot], theme["mode"], slot))


def write_files(files):
    """Atomically replace every {path: text} that differs. All new contents
    are staged as temp files first; only if ALL staged successfully are
    they renamed into place (same-filesystem renames). A failure while
    staging leaves every existing file untouched. Returns changed paths."""
    staged = []
    try:
        for path, text in files.items():
            try:
                # bytes, not text: a damaged file must just count as changed
                with open(path, "rb") as f:
                    if f.read() == text.encode("utf-8"):
                        continue
            except FileNotFoundError:
                pass
            os.makedirs(os.path.dirname(path), exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
            staged.append((tmp, path))
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(text)
            os.chmod(tmp, 0o644)
    except BaseException:
        for tmp, _ in staged:
            if os.path.exists(tmp):
                os.unlink(tmp)
        raise
    for tmp, path in staged:
        os.replace(tmp, path)
    return [path for _, path in staged]


def state_text(state):
    return ("".join("%s=%s\n" % (k, state[k]) for k in ("dark", "light", "mode"))
            + "text-size=%s\n" % state.get("text_size", DEFAULT_TEXT_SIZE)
            + "".join("wallpaper.%s=%s\n" % (tid, f)
                      for tid, f in sorted(state.get("wallpapers", {}).items())))


# --- rendering (the only place theme colors are turned into app formats) ---

def render(state, valid):
    theme = valid[state[state["mode"]]]
    c = theme["colors"]
    rgb = {r: "rgb(%s)" % c[r].lstrip("#") for r in ROLES}
    size = text_size(state)
    # Ghostty: its default 12 pt scaled like everything else, in 0.5 pt steps
    ghostty_pt = round(GHOSTTY_DEFAULT_PT * size / DEFAULT_TEXT_SIZE * 2) / 2
    return {
        # Quickshell: Colors.qml reads this (on start and on IPC theme.reload).
        # The wallpaper rides along (null = none: background color).
        "colors.json": json.dumps({"id": theme["id"], "name": theme["name"],
                                   "mode": state["mode"], "colors": c,
                                   "text_size": size,
                                   "wallpaper": wallpaper(state, theme["id"])}, indent=2) + "\n",
        # Hyprland: hyprland.lua does dofile() on this.
        "hyprland.lua": "-- generated by `theme` - do not edit\nreturn {\n"
                        + "".join('    %s = "%s",\n' % (r, rgb[r]) for r in ROLES) + "}\n",
        # hyprlock: hyprlock.conf sources this.
        "hyprlock.conf": "# generated by `theme` - do not edit\n"
                         + "".join("$%s = %s\n" % (r, rgb[r]) for r in ROLES),
        # Ghostty: config.ghostty includes this (config-file = ?...).
        # Cursor and selection come from the semantic roles (accent =
        # "selection fill", accent_foreground = "text on it"), the 16 ANSI
        # colors from the theme's terminal palette.
        "ghostty": "# generated by `theme` - do not edit\n"
                   + "background = %s\nforeground = %s\n" % (c["background"], c["foreground"])
                   + "cursor-color = %s\ncursor-text = %s\n" % (c["foreground"], c["background"])
                   + "selection-background = %s\nselection-foreground = %s\n" % (c["accent"], c["accent_foreground"])
                   + "".join("palette = %d=%s\n" % (i, v) for i, v in enumerate(theme["terminal"]))
                   + "font-size = %g\n" % ghostty_pt,
        "neovim.lua": render_neovim_spec(valid),
        # btop: ~/.config/btop/themes/workstation.theme links here
        # (roles/theme); read at btop's start - no live reload exists.
        "btop.theme": render_btop(theme),
        # Neovim: the active theme's colorscheme (neovim.lua applies it)
        "neovim-current.lua": render_neovim_current(theme),
    }


BTOP_LINE = re.compile(r'^theme\[([a-z_]+)\]\s*=\s*"(#[0-9a-fA-F]{6}|)"\s*$')


def btop_lines(text):
    """Only btop color assignments - a theme file is data, nothing else passes."""
    out = []
    for line in text.splitlines():
        m = BTOP_LINE.match(line.strip())
        if m:
            out.append('theme[%s]="%s"' % (m.group(1), m.group(2).lower()))
    return out


def render_btop(theme):
    if theme.get("btop"):
        try:
            with open(theme["btop"], encoding="utf-8", errors="replace") as f:
                lines = btop_lines(f.read())
            if lines:
                return "# generated by `theme` from the theme's own btop.theme - do not edit\n" + "\n".join(lines) + "\n"
        except OSError:
            pass
    c, t = theme["colors"], theme["terminal"]
    keys = {
        "main_bg": c["background"], "main_fg": c["foreground"], "title": c["foreground_strong"],
        "hi_fg": c["accent"], "selected_bg": c["surface"], "selected_fg": c["foreground_strong"],
        "inactive_fg": c["foreground_muted"], "graph_text": c["foreground"], "meter_bg": c["surface"],
        "proc_misc": c["accent"], "cpu_box": c["border"], "mem_box": c["border"], "net_box": c["border"],
        "proc_box": c["border"], "div_line": c["border"],
        "temp_start": t[2], "temp_mid": t[3], "temp_end": t[1],
        "cpu_start": t[6], "cpu_mid": t[4], "cpu_end": t[5],
        "free_start": t[2], "free_mid": t[2], "free_end": t[10],
        "cached_start": t[4], "cached_mid": t[4], "cached_end": t[12],
        "available_start": t[3], "available_mid": t[3], "available_end": t[11],
        "used_start": t[1], "used_mid": t[1], "used_end": t[9],
        "download_start": t[6], "download_mid": t[4], "download_end": t[12],
        "upload_start": t[5], "upload_mid": t[13], "upload_end": t[9],
        "process_start": t[6], "process_mid": t[4], "process_end": t[5],
    }
    return ("# generated by `theme` from the theme's palette - do not edit\n"
            + "".join('theme[%s]="%s"\n' % (k, v.lower()) for k, v in keys.items()))


def nvim_module(n):
    """Lua module of a colorscheme plugin: its lazy name, else the repo name."""
    return n.get("name") or re.sub(r"\.nvim$", "", n["plugin"].split("/")[1])


def render_neovim_current(theme):
    """The active theme's colorscheme + background; for a generic plugin
    themed by a color table (Omarchy 4's aether.nvim) also that table, which
    neovim.lua hands to the plugin's setup() before the colorscheme."""
    n = theme["neovim"] or {}
    lines = ['    theme = "%s",' % theme["id"],
             '    colorscheme = "%s",' % n.get("colorscheme", "default"),
             '    background = "%s",' % theme["mode"]]
    if n.get("colors"):
        lines.append('    module = "%s",' % nvim_module(n))
        lines.append("    colors = {")
        lines += ['        ["%s"] = "%s",' % (k, v.lower()) for k, v in sorted(n["colors"].items())]
        lines.append("    },")
    return "-- generated by `theme` - do not edit\nreturn {\n" + "\n".join(lines) + "\n}\n"


def render_neovim_spec(valid):
    """lazy.nvim spec: every theme's colorscheme plugin + LazyVim's
    colorscheme hook. Values are regex-validated (no quoting needed)."""
    plugins = {}
    for t in valid.values():
        n = t["neovim"]
        if n:
            plugins.setdefault(n["plugin"], (n.get("name"), n.get("branch")))
    lines = ["-- generated by `theme` - do not edit (see roles/theme/templates/theme.j2)",
             "-- lazy.nvim spec: the Neovim port of every workstation theme (lazy, no",
             "-- download on a switch) + LazyVim's colorscheme = the active theme.",
             "local current = (os.getenv(\"XDG_CONFIG_HOME\") or (os.getenv(\"HOME\") .. \"/.config\"))",
             "    .. \"/workstation/theme/neovim-current.lua\"",
             "",
             "local function apply()",
             "    local ok, t = pcall(dofile, current)",
             "    if not ok or type(t) ~= \"table\" then return end",
             "    vim.o.background = t.background",
             "    if t.colors and t.module then",
             "        pcall(function() require(t.module).setup({ colors = t.colors }) end)",
             "    end",
             "    if not pcall(vim.cmd.colorscheme, t.colorscheme) then",
             "        vim.notify(\"workstation theme: colorscheme \" .. t.colorscheme .. \" not available\", vim.log.levels.WARN)",
             "    end",
             "end",
             "",
             "-- The theme helper fires this in every running Neovim after a switch.",
             "vim.api.nvim_create_autocmd(\"User\", {",
             "    group = vim.api.nvim_create_augroup(\"workstation-theme\", { clear = true }),",
             "    pattern = \"WorkstationTheme\",",
             "    callback = function() vim.schedule(apply) end,",
             "})",
             "",
             "return {"]
    for plugin, (name, branch) in sorted(plugins.items()):
        lines.append('    { "%s",%s%s lazy = true, priority = 1000 },'
                     % (plugin, ' name = "%s",' % name if name else "",
                        ' branch = "%s",' % branch if branch else ""))
    lines += ["    { \"LazyVim/LazyVim\", opts = { colorscheme = apply } },", "}", ""]
    return "\n".join(lines)


def _nvim_servers():
    """Default RPC sockets of our running Neovims ($XDG_RUNTIME_DIR/nvim.<pid>.<n>)."""
    run = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    try:
        names = os.listdir(run)
    except OSError:
        return []
    return [os.path.join(run, n) for n in sorted(names) if re.match(r"^nvim\.\d+\.\d+$", n)]


# --- applying live (user level only, best effort, never a lingering process) -

def _session_env():
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=%s/bus" % env["XDG_RUNTIME_DIR"])
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE") or not env.get("WAYLAND_DISPLAY"):
        try:
            out = subprocess.run(["hyprctl", "instances", "-j"], env=env, capture_output=True,
                                 text=True, timeout=5).stdout
            inst = json.loads(out or "[]")
            if inst:
                env.setdefault("HYPRLAND_INSTANCE_SIGNATURE", inst[0]["instance"])
                env.setdefault("WAYLAND_DISPLAY", inst[0]["wl_socket"])
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    return env


def _run(argv, env):
    try:
        return subprocess.run(argv, env=env, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None


def _signal(name, sig):
    """Send `sig` to every process of ours named `name` (no-op if none)."""
    res = _run(["pgrep", "-u", str(os.getuid()), "-x", name], dict(os.environ))
    for pid in (res.stdout.split() if res is not None else []):
        try:
            os.kill(int(pid), sig)
        except (OSError, ValueError):
            pass


def _same(current, wanted):
    try:
        return abs(float(current) - float(wanted)) < 1e-6
    except ValueError:
        return current == wanted


def apply_live(state, changed_files):
    env = _session_env()
    if "ghostty" in changed_files:
        # Ghostty (1.3) reloads its configuration on SIGUSR2 - every open
        # window picks up the new colors, no restart.
        _signal("ghostty", signal.SIGUSR2)
    if "colors.json" in changed_files:
        _run(["qs", "ipc", "--any-display", "call", "theme", "reload"], env)
    if "hyprland.lua" in changed_files and env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        _run(["hyprctl", "reload"], env)
    if "neovim-current.lua" in changed_files:
        # Each running Neovim re-applies neovim-current.lua (the autocmd from
        # neovim.lua); one without it just ignores the event. A stale socket
        # fails at once.
        for sock in _nvim_servers():
            _run(["nvim", "--clean", "--headless", "--server", sock, "--remote-expr",
                  "execute('silent doautocmd User WorkstationTheme')"], env)
    gtk_changed = False
    want = {"color-scheme": "'prefer-%s'" % state["mode"],
            "gtk-theme": "'Adwaita-dark'" if state["mode"] == "dark" else "'Adwaita'",
            # GTK text size: relative to the GTK font's own size
            "text-scaling-factor": "%g" % (text_size(state) / DEFAULT_TEXT_SIZE)}
    for key, value in want.items():
        cur = _run(["gsettings", "get", "org.gnome.desktop.interface", key], env)
        if cur is not None and cur.returncode == 0 and _same(cur.stdout.strip(), value):
            continue
        res = _run(["gsettings", "set", "org.gnome.desktop.interface", key, value], env)
        gtk_changed = gtk_changed or (res is not None and res.returncode == 0)
    return gtk_changed


def commit(state, valid):
    """Validate, render everything, write outputs + state together, then
    apply live. Returns whether anything changed."""
    check_state(state, valid)              # nothing written unless the new state is valid
    outputs = render(state, valid)         # every output exists before anything is written
    files = {os.path.join(OUT_DIR, name): text for name, text in outputs.items()}
    files[STATE_FILE] = state_text(state)  # state is only written together with its outputs
    changed = write_files(files)
    changed_files = [os.path.basename(p) for p in changed if p != STATE_FILE]
    gtk_changed = apply_live(state, changed_files)
    return bool(changed or gtk_changed)


# --- theme sources: Omarchy theme repositories as UNTRUSTED DATA ----------

URL_RE = re.compile(r"^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/[A-Za-z0-9._~/-]+$")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
MAX_TEXT = 256 * 1024          # bytes of one source file we parse
# Raised whenever the compiler's output changes: sync-sources then
# recompiles existing themes from their local source (no network).
COMPILER = 2
# Files the compiler understands; everything else is reported as ignored.
KNOWN = ("colors.toml", "alacritty.toml", "ghostty.conf", "hyprland.conf",
         "neovim.lua", "btop.theme", "backgrounds")


def check_url(url):
    if not (isinstance(url, str) and len(url) < 300 and URL_RE.match(url) and ".." not in url):
        raise ThemeError("not a plain https repository URL (https://host/owner/repo): %r" % url)
    return url.rstrip("/")


def derive_id_name(url):
    """omarchy-retro-82-theme -> ('retro-82', 'Retro 82')"""
    repo = url.rstrip("/").split("/")[-1]
    repo = re.sub(r"\.git$", "", repo).lower()
    repo = re.sub(r"^omarchy-", "", repo)
    repo = re.sub(r"-theme$", "", repo)
    tid = re.sub(r"[^a-z0-9]+", "-", repo).strip("-")
    if not tid or not ID_RE.match(tid):
        raise ThemeError("cannot derive a theme id from %r" % url)
    return tid, " ".join(w if w.isdigit() else w.capitalize() for w in tid.split("-"))


def read_manifest():
    try:
        with open(MANIFEST, encoding="utf-8") as f:
            data = yaml.safe_load(f) or {}
    except FileNotFoundError:
        return []
    except (yaml.YAMLError, UnicodeDecodeError) as e:
        raise ThemeError("%s is not valid YAML: %s" % (MANIFEST, str(e).splitlines()[0]))
    entries = data.get("sources") or [] if isinstance(data, dict) else []
    out = []
    for e in entries:
        if not (isinstance(e, dict) and isinstance(e.get("id"), str) and ID_RE.match(e["id"])
                and isinstance(e.get("commit"), str) and SHA_RE.match(e["commit"])
                and e.get("mode") in MODES and isinstance(e.get("name"), str) and e["name"]):
            raise ThemeError("invalid entry in %s: %r" % (MANIFEST, e))
        check_url(e.get("url"))
        out.append({k: e[k] for k in ("id", "name", "url", "commit", "mode")})
    return out


MANIFEST_HEADER = """\
# Theme sources: Omarchy-style theme repositories, each pinned to the exact
# commit that was tested. Written by `theme import` / `theme remove`
# (Appearance -> Theme -> Import) - commit the change to keep the theme on
# the next installation; provisioning (`theme sync-sources`, roles/theme)
# installs exactly these. An id that also exists under themes/ is that
# bundled theme's source: its theme.yml stays authoritative, the source adds
# backgrounds and app payloads. Repositories are data, never executed -
# see docs/DESIGN_SYSTEM.md "Theme sources".
"""


def write_manifest(entries):
    text = MANIFEST_HEADER + yaml.safe_dump({"sources": entries}, sort_keys=False, allow_unicode=True)
    write_files({MANIFEST: text})


def git(args, cwd=None, timeout=600):
    """git with everything a repository could use to run code switched off."""
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": os.path.expanduser("~"),
           "LC_ALL": "C", "GIT_TERMINAL_PROMPT": "0", "GIT_ASKPASS": "/bin/false",
           "SSH_ASKPASS": "/bin/false", "GCM_INTERACTIVE": "never",
           "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"}
    safe = ["-c", "core.hooksPath=/dev/null", "-c", "core.symlinks=false",
            "-c", "core.fsmonitor=false", "-c", "protocol.allow=never",
            "-c", "protocol.https.allow=always", "-c", "submodule.recurse=false",
            "-c", "credential.helper=", "-c", "advice.detachedHead=false"]
    try:
        r = subprocess.run(["git"] + safe + args, cwd=cwd, env=env, capture_output=True,
                           text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise ThemeError("git timed out: %s" % " ".join(args[:2]))
    if r.returncode != 0:
        raise ThemeError("git %s failed: %s" % (args[0], (r.stderr.strip().splitlines() or ["?"])[-1]))
    return r.stdout.strip()


def fetch_source(url, ref):
    """Shallow checkout of url at ref (a pinned commit or HEAD) into a new
    temporary directory below SOURCES_DIR; returns (dir, commit)."""
    os.makedirs(SOURCES_DIR, exist_ok=True)
    tmp = tempfile.mkdtemp(prefix=".fetch-", dir=SOURCES_DIR)
    try:
        git(["init", "-q", "--template=", tmp])
        git(["remote", "add", "origin", url], cwd=tmp)
        git(["fetch", "-q", "--depth", "1", "--no-tags", "--no-recurse-submodules", "origin", ref], cwd=tmp)
        git(["checkout", "-q", "--detach", "FETCH_HEAD"], cwd=tmp)
        commit = git(["rev-parse", "HEAD"], cwd=tmp)
        if ref != "HEAD" and commit != ref:
            raise ThemeError("%s is at %s, not the pinned %s" % (url, commit, ref))
        return tmp, commit
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise


def read_source_file(src, name):
    """A regular (non-symlink) file of the source, at most MAX_TEXT bytes, or None."""
    path = os.path.join(src, name)
    if os.path.islink(path) or not os.path.isfile(path) or os.path.getsize(path) > MAX_TEXT:
        return None
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def hexcolor(v):
    if isinstance(v, str):
        v = v.strip().strip("'\"")
        if re.match(r"^#?[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$", v):
            return "#" + v.lstrip("#")[:6].lower()
    return None


def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def luminance(h):
    def ch(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (ch(c) for c in rgb(h))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def mix(a, b, t):
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * t) for x, y in zip(rgb(a), rgb(b)))


def source_palette(src, used, notes):
    """bg/fg/accent/16 terminal colors (+ optional hints) from the first
    palette file the source has - parsed as data (TOML / key=value)."""
    pal = {}
    text = read_source_file(src, "colors.toml")
    if text is not None:
        try:
            d = tomllib.loads(text)
            pal = {"bg": hexcolor(d.get("background")), "fg": hexcolor(d.get("foreground")),
                   "accent": hexcolor(d.get("accent")), "muted": hexcolor(d.get("muted")),
                   "surface": hexcolor(d.get("lighter_bg")), "strong": hexcolor(d.get("bright_fg")),
                   "mode": d.get("mode") if d.get("mode") in MODES else None,
                   "terminal": [hexcolor(d.get("color%d" % i)) for i in range(16)]}
            used.append("colors.toml")
        except tomllib.TOMLDecodeError as e:
            notes.append("colors.toml unreadable: %s" % e)
    if not pal.get("bg") or None in pal.get("terminal", [None]):
        text = read_source_file(src, "alacritty.toml")
        if text is not None:
            try:
                c = tomllib.loads(text).get("colors", {})
                names = ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white")
                prim = c.get("primary", {})
                pal = {"bg": hexcolor(prim.get("background")), "fg": hexcolor(prim.get("foreground")),
                       "terminal": [hexcolor(c.get(part, {}).get(n)) for part in ("normal", "bright") for n in names]}
                used.append("alacritty.toml")
            except (tomllib.TOMLDecodeError, AttributeError) as e:
                notes.append("alacritty.toml unreadable: %s" % e)
    if not pal.get("bg") or None in pal.get("terminal", [None]):
        text = read_source_file(src, "ghostty.conf")
        if text is not None:
            g = {"terminal": [None] * 16}
            for line in text.splitlines():
                m = re.match(r"^\s*(background|foreground)\s*=\s*(#?[0-9a-fA-F]{6})\s*$", line)
                if m:
                    g["bg" if m.group(1) == "background" else "fg"] = hexcolor(m.group(2))
                m = re.match(r"^\s*palette\s*=\s*([0-9]{1,2})\s*=\s*(#?[0-9a-fA-F]{6})\s*$", line)
                if m and int(m.group(1)) < 16:
                    g["terminal"][int(m.group(1))] = hexcolor(m.group(2))
            pal = g
            used.append("ghostty.conf")
    text = read_source_file(src, "hyprland.conf")
    if text is not None:
        m = re.search(r"col\.active_border\s*=\s*rgba?\(\s*([0-9a-fA-F]{6})", text)
        if m:
            pal.setdefault("border_hint", "#" + m.group(1).lower())
            used.append("hyprland.conf")
    if not pal.get("bg") or not pal.get("fg") or None in pal.get("terminal", [None]):
        raise ThemeError("no usable palette (colors.toml, alacritty.toml or ghostty.conf with "
                         "background, foreground and 16 terminal colors)")
    return pal


def derive_roles(pal):
    """Our semantic roles from a source palette - only where the source has
    no direct value; contrast decides between candidates."""
    bg, fg, t = pal["bg"], pal["fg"], pal["terminal"]
    accent = pal.get("accent") or pal.get("border_hint") or t[4]
    strong = max([c for c in (pal.get("strong"), t[15], fg) if c], key=lambda c: contrast(c, bg))
    muted = pal.get("muted")
    if not muted or contrast(muted, bg) < 2.0:
        muted = mix(bg, fg, 0.55)
    surface = pal.get("surface")
    if not surface or surface == bg:
        surface = mix(bg, fg, 0.10)
    return {
        "background": bg, "surface": surface, "foreground": fg, "foreground_strong": strong,
        "foreground_muted": muted, "accent": accent,
        "accent_foreground": bg if contrast(accent, bg) >= contrast(accent, fg) else fg,
        "border": mix(bg, fg, 0.25), "border_active": accent, "error": t[1],
    }


def strip_lua_comments(text):
    text = re.sub(r"--\[(=*)\[.*?\]\1\]", "", text, flags=re.S)
    out = []
    for line in text.splitlines():
        quote, i = None, 0
        while i < len(line):
            ch = line[i]
            if quote:
                if ch == "\\":
                    i += 1
                elif ch == quote:
                    quote = None
            elif ch in "'\"":
                quote = ch
            elif line.startswith("--", i):
                line = line[:i]
                break
            i += 1
        out.append(line)
    return "\n".join(out)


def source_neovim(src, used):
    """{plugin, name?, colorscheme} from neovim.lua read as TEXT (never run):
    the first plugin string other than LazyVim, its name = ..., and
    colorscheme = ...; each value regex-checked."""
    text = read_source_file(src, "neovim.lua")
    if text is None:
        return None
    code = strip_lua_comments(text)
    plugin = next((m for m in re.finditer(r"""["']([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)["']""", code)
                   if m.group(1) != "LazyVim/LazyVim"), None)
    scheme = re.search(r"""colorscheme\s*=\s*["']([A-Za-z0-9_.-]+)["']""", code)
    if not plugin or not scheme:
        return None
    out = {"plugin": plugin.group(1), "colorscheme": scheme.group(1)}
    # the plugin's own table up to its first nested table: name, branch
    head = code[plugin.end():]
    head = head[:min([i for i in (head.find("{"), head.find("}")) if i >= 0] or [len(head)])]
    name = re.search(r"""\bname\s*=\s*["']([A-Za-z0-9_.-]+)["']""", head)
    if name:
        out["name"] = name.group(1)
    branch = re.search(r"""\bbranch\s*=\s*["']([A-Za-z0-9._/-]{1,60})["']""", head)
    if branch:
        out["branch"] = branch.group(1)
    # a generic plugin themed by data: opts = { colors = { key = "#hex" } }
    table = re.search(r"\bcolors\s*=\s*\{(.*?)\}", code, flags=re.S)
    if table:
        colors = dict(re.findall(r"""\b([a-z][a-z0-9_]{0,31})\s*=\s*["'](#[0-9a-fA-F]{6})["']""", table.group(1))[:64])
        if colors:
            out["colors"] = {k: v.lower() for k, v in colors.items()}
    used.append("neovim.lua")
    return out


def compile_source(src, entry):
    """Normalize a fetched source into COMPILED_DIR/<id> (atomically):
    marker, theme.yml (palette -> roles + terminal, neovim), btop.theme
    (color lines only), backgrounds -> the source's backgrounds/, and
    source.json (url, commit, what was used / ignored)."""
    used, notes = [], []
    pal = source_palette(src, used, notes)
    if pal.get("mode") and pal["mode"] != entry["mode"]:
        notes.append("the source says %s, imported as %s (your choice)" % (pal["mode"], entry["mode"]))
    theme = {"name": entry["name"], "colors": derive_roles(pal),
             "terminal": dict(zip(TERMINAL, pal["terminal"]))}
    nvim = source_neovim(src, used)
    if nvim:
        theme["neovim"] = nvim
    btop_text = read_source_file(src, "btop.theme")
    btop = btop_lines(btop_text) if btop_text else []
    if btop:
        used.append("btop.theme")
    bg_src = os.path.join(src, "backgrounds")
    has_bg = os.path.isdir(bg_src) and not os.path.islink(bg_src)
    if has_bg:
        used.append("backgrounds")
    ignored = sorted(n for n in os.listdir(src) if n not in KNOWN and n != ".git" and n not in used)

    os.makedirs(COMPILED_DIR, exist_ok=True)
    tmp = tempfile.mkdtemp(prefix=".compile-", dir=COMPILED_DIR)
    try:
        open(os.path.join(tmp, entry["mode"]), "w").close()
        with open(os.path.join(tmp, "theme.yml"), "w", encoding="utf-8") as f:
            f.write("# compiled by `theme` from %s @ %s - do not edit\n" % (entry["url"], entry["commit"]))
            yaml.safe_dump(theme, f, sort_keys=False, allow_unicode=True)
        if btop:
            with open(os.path.join(tmp, "btop.theme"), "w", encoding="utf-8") as f:
                f.write("\n".join(btop) + "\n")
        if has_bg:
            os.symlink(os.path.abspath(bg_src), os.path.join(tmp, "backgrounds"))
        else:
            os.mkdir(os.path.join(tmp, "backgrounds"))
        with open(os.path.join(tmp, "source.json"), "w", encoding="utf-8") as f:
            json.dump({"compiler": COMPILER, "url": entry["url"], "commit": entry["commit"], "mode": entry["mode"],
                       "used": used, "ignored": ignored, "notes": notes}, f, indent=2)
        for root, dirs, files in os.walk(tmp):
            for n in dirs + files:
                p = os.path.join(root, n)
                if not os.path.islink(p):
                    os.chmod(p, 0o755 if os.path.isdir(p) else 0o644)
        os.chmod(tmp, 0o755)
        replace_dir(tmp, os.path.join(COMPILED_DIR, entry["id"]))
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    return {"used": used, "ignored": ignored, "notes": notes}


def replace_dir(new, final):
    old = None
    if os.path.lexists(final):
        old = final + ".old-%d" % os.getpid()
        os.rename(final, old)
    os.rename(new, final)
    if old:
        shutil.rmtree(old, ignore_errors=True)


def source_commit(theme_id):
    path = os.path.join(SOURCES_DIR, theme_id)
    if not os.path.isdir(os.path.join(path, ".git")):
        return None
    try:
        return git(["rev-parse", "HEAD"], cwd=path, timeout=30)
    except ThemeError:
        return None


def compiled_commit(theme_id):
    """The commit a compiled theme was built from - None when it is missing
    or was built by an older compiler (then it is rebuilt)."""
    try:
        with open(os.path.join(COMPILED_DIR, theme_id, "source.json"), encoding="utf-8") as f:
            info = json.load(f)
    except (OSError, ValueError):
        return None
    return info.get("commit") if info.get("compiler") == COMPILER else None


def lock():
    os.makedirs(OUT_DIR, exist_ok=True)
    handle = open(os.path.join(OUT_DIR, ".lock"), "w")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def import_theme(url, mode):
    url = check_url(url)
    if mode not in MODES:
        raise ThemeError("mode must be dark or light")
    tid, name = derive_id_name(url)
    # the slow clone runs without the lock - theme switches stay possible
    tmp, commit = fetch_source(url, "HEAD")
    try:
        with lock():
            taken = [e["id"] for e in read_manifest()]
            if tid in taken or theme_dirs(tid) or os.path.lexists(os.path.join(SOURCES_DIR, tid)):
                raise ThemeError("a theme with the id %r already exists - nothing was changed" % tid)
            entry = {"id": tid, "name": name, "url": url, "commit": commit, "mode": mode}
            dest = os.path.join(SOURCES_DIR, tid)
            os.rename(tmp, dest)
            tmp = None
            try:
                report = compile_source(dest, entry)
                theme, errors = load_theme(tid)
                if errors:
                    raise ThemeError("compiled theme is invalid: %s" % "; ".join(errors))
                write_manifest(read_manifest() + [entry])
            except BaseException:
                shutil.rmtree(dest, ignore_errors=True)
                shutil.rmtree(os.path.join(COMPILED_DIR, tid), ignore_errors=True)
                raise
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    return dict(entry, **report)


def remove_theme(tid):
    entries = read_manifest()
    entry = next((e for e in entries if e["id"] == tid), None)
    if entry is None:
        raise ThemeError("%r is not an imported theme" % tid)
    if os.path.isdir(os.path.join(THEMES_DIR, tid)):
        raise ThemeError("%r is a bundled theme of this repository - it cannot be removed here" % tid)
    state = read_state()
    if state and tid in (state.get("dark"), state.get("light")):
        raise ThemeError("%s is selected as the %s theme - select another one first"
                         % (entry["name"], "dark" if state.get("dark") == tid else "light"))
    write_manifest([e for e in entries if e["id"] != tid])
    for base in (COMPILED_DIR, SOURCES_DIR):
        path = os.path.join(base, tid)
        if os.path.islink(path):
            os.unlink(path)
        elif os.path.isdir(path):
            shutil.rmtree(path)


def sync_sources():
    """Provisioning: every manifest entry fetched at its pinned commit and
    compiled; untouched when both already match. Returns changed ids."""
    changed = []
    for entry in read_manifest():
        tid = entry["id"]
        if source_commit(tid) == entry["commit"] and compiled_commit(tid) == entry["commit"]:
            continue
        dest = os.path.join(SOURCES_DIR, tid)
        if source_commit(tid) != entry["commit"]:
            tmp, _ = fetch_source(entry["url"], entry["commit"])
            replace_dir(tmp, dest)
        compile_source(dest, entry)
        changed.append(tid)
    return changed


def sources_status(state):
    return [dict(e, bundled=os.path.isdir(os.path.join(THEMES_DIR, e["id"])),
                 installed=os.path.isdir(os.path.join(COMPILED_DIR, e["id"])),
                 selected=bool(state) and e["id"] in (state.get("dark"), state.get("light")))
            for e in read_manifest()]


# --- CLI -------------------------------------------------------------------

def usage():
    sys.stderr.write("usage: theme status [--json] | list dark|light | current | toggle |"
                     " mode dark|light | select dark|light <id> | apply [...] | validate |"
                     " wallpaper list | wallpaper set <file> | text-size [<px>] |"
                     " import <url> dark|light | remove <id> | sync-sources\n")
    return 2


def require_state():
    state = read_state()
    if state is None:
        raise ThemeError("no theme state yet (%s) - run bootstrap.sh once" % STATE_FILE)
    return state


# Commands that change state/outputs run one at a time: each is a
# read-modify-write of the state plus a live apply, and two at once (a fast
# double click on the bar's theme icon, a bar click during bootstrap) lost
# one of the changes - measured on arch-dev: 7 of 20 rounds of parallel
# toggles. A blocking flock (held for one run, typically <1 s) queues them;
# read-only commands need none (every file is replaced atomically).
MUTATING = ("toggle", "mode", "select", "wallpaper set", "apply", "text-size", "remove", "sync-sources")
# `import` takes the lock itself, after its (slow) clone.


def serialize(cmd, args):
    if cmd not in MUTATING and " ".join([cmd] + args[:1]) not in MUTATING:
        return None
    os.makedirs(OUT_DIR, exist_ok=True)
    lock = open(os.path.join(OUT_DIR, ".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def main(argv):
    if not argv:
        return usage()
    cmd, args = argv[0], argv[1:]
    _lock = serialize(cmd, args)  # noqa: F841 - released at exit
    valid, invalid = discover()

    if cmd == "validate":
        for tid, errors in sorted(invalid.items()):
            for e in errors:
                print("%s: %s" % (tid, e), file=sys.stderr)
        if not valid:
            print("no valid themes in %s" % THEMES_DIR, file=sys.stderr)
        return 1 if invalid or not valid else 0

    if cmd == "status":
        state = read_state()
        status = {
            "state": state,
            "dark": [{"id": t["id"], "name": t["name"]} for t in valid.values() if t["mode"] == "dark"],
            "light": [{"id": t["id"], "name": t["name"]} for t in valid.values() if t["mode"] == "light"],
            "invalid": invalid,
            "wallpaper": wallpaper_list(state) if state and state.get(state["mode"]) in valid else None,
            "text_sizes": list(TEXT_SIZES),
            "sources": sources_status(state),
        }
        if args == ["--json"]:
            print(json.dumps(status))
        else:
            print("state: %s" % (state_text(state).replace("\n", " ") if state else "none"))
            for m in MODES:
                print("%s: %s" % (m, ", ".join("%s (%s)" % (t["id"], t["name"]) for t in status[m])))
            for tid, errors in invalid.items():
                print("invalid: %s - %s" % (tid, "; ".join(errors)))
        return 0

    if cmd == "list" and len(args) == 1 and args[0] in MODES:
        for t in valid.values():
            if t["mode"] == args[0]:
                print(t["id"])
        return 0

    if cmd == "current" and not args:
        print(state_text(require_state()).replace("\n", " ").strip())
        return 0

    if cmd == "toggle" and not args:
        state = require_state()
        state["mode"] = "light" if state["mode"] == "dark" else "dark"
        commit(state, valid)
        return 0

    if cmd == "mode" and len(args) == 1 and args[0] in MODES:
        state = require_state()
        state["mode"] = args[0]
        commit(state, valid)
        return 0

    if cmd == "select" and len(args) == 2 and args[0] in MODES:
        state = require_state()
        state[args[0]] = args[1]
        commit(state, valid)
        return 0

    if cmd == "wallpaper" and args == ["list"]:
        state = require_state()
        print(json.dumps(wallpaper_list(state)))
        return 0

    if cmd == "wallpaper" and len(args) == 2 and args[0] == "set":
        state = require_state()
        tid = state[state["mode"]]
        if args[1] not in backgrounds(tid):
            raise ThemeError("%r is not a wallpaper of theme %r (themes/%s/backgrounds/)" % (args[1], tid, tid))
        state["wallpapers"][tid] = args[1]
        commit(state, valid)
        return 0

    if cmd == "text-size" and not args:
        print(text_size(require_state()) or "invalid")
        return 0

    if cmd == "text-size" and len(args) == 1:
        state = require_state()
        state["text_size"] = args[0]
        commit(state, valid)
        return 0

    if cmd == "import" and len(args) == 2:
        print(json.dumps(import_theme(args[0], args[1])))
        return 0

    if cmd == "remove" and len(args) == 1:
        remove_theme(args[0])
        print("removed %s" % args[0])
        return 0

    if cmd == "sync-sources" and not args:
        changed = sync_sources()
        if changed:
            print("changed: %s" % " ".join(changed), file=sys.stderr)
        print("changed" if changed else "unchanged")
        return 0

    if cmd == "apply":
        opts = dict(zip(args[0::2], args[1::2]))
        state = read_state()
        if state is None:
            state = {"dark": opts.get("--init-dark", ""), "light": opts.get("--init-light", ""),
                     "mode": opts.get("--init-mode", ""), "wallpapers": {}}
        print("changed" if commit(state, valid) else "unchanged")
        return 0

    return usage()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except ThemeError as e:
        print("theme: %s" % e, file=sys.stderr)
        sys.exit(1)
    except OSError as e:
        # e.g. an unwritable output dir - write_files() has already
        # discarded its staged files, so the previous theme stays intact.
        print("theme: could not write theme files, nothing changed: %s" % e, file=sys.stderr)
        sys.exit(1)
