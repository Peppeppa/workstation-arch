#!/usr/bin/env python3
# Managed by Ansible (roles/theme/templates/theme.j2) - do not edit by hand.
#
# `theme` - the ONE implementation of the theme system (see
# docs/DESIGN_SYSTEM.md "Themes"): discovery, contract validation,
# rendering of every consumer's color file, the persistent user state and
# applying it live. Ansible provisions by calling `theme validate` and
# `theme apply`; the Quickshell bar calls `theme status|toggle|select`.
# Nothing else renders theme colors.
#
# On-demand only: runs, does its work, exits. No daemon, no watcher.
#
#   theme status [--json]          state + valid dark/light themes (+ invalid ones)
#   theme list dark|light          valid theme ids of that mode, one per line
#   theme current                  dark=<id> light=<id> mode=<mode>
#   theme toggle                   flip mode, apply
#   theme mode dark|light          set mode, apply
#   theme select dark|light <id>   pick the dark/light theme; applied only if that
#                                  mode is active (never switches the mode)
#   theme apply [--init-dark ID --init-light ID --init-mode MODE]
#                                  (re)render + apply the current state; creates
#                                  the state from the --init-* values only if it
#                                  does not exist yet. Prints changed/unchanged.
#   theme validate                 check every theme directory, exit 1 if any is invalid
#   theme wallpaper list           JSON: the active theme's backgrounds + the one in use
#   theme wallpaper set <file>     use backgrounds/<file> for the active theme (remembered
#                                  per theme), apply
#
# Theme registry = the theme directories themselves (no list anywhere else):
#   <THEMES_DIR>/<id>/{dark|light, theme.yml, backgrounds/}
#
# Outputs (~/.config/workstation/theme/): colors.json (Quickshell: colors +
# wallpaper), hyprland.lua, hyprlock.conf, ghostty - each app includes its file.
#
# Wallpapers: the image files in the active theme's backgrounds/ ARE the
# list (no second registry). The choice is remembered per theme in the
# state file (wallpaper.<id>=<file>); without a (still existing) choice the
# first file in sorted order is used; with no files there is no wallpaper
# (Quickshell then shows the theme's background color).

import json
import os
import re
import signal
import subprocess
import sys
import tempfile

import yaml

THEMES_DIR = "{{ theme_dir }}"
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
STATE_FILE = os.path.join(CONFIG_HOME, "workstation", "theme-state")
OUT_DIR = os.path.join(CONFIG_HOME, "workstation", "theme")

MODES = ("dark", "light")
# Semantic color contract - every theme fills exactly these roles.
ROLES = (
    "background", "surface", "foreground", "foreground_muted", "accent",
    "accent_foreground", "border", "border_active", "error",
)
# Terminal contract - the 16 ANSI colors (0-15, in this order); every
# theme has them, taken from the theme's own terminal palette.
TERMINAL = (
    "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
    "bright_black", "bright_red", "bright_green", "bright_yellow",
    "bright_blue", "bright_magenta", "bright_cyan", "bright_white",
)
THEME_KEYS = {"name", "colors", "terminal"}
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
# Wallpaper formats Quickshell can show (WebP via qt6-imageformats); GIF
# is shown animated.
WALLPAPER_EXT = (".png", ".jpg", ".jpeg", ".webp", ".gif")
ANIMATED_EXT = (".gif",)


class ThemeError(Exception):
    pass


# --- discovery / contract --------------------------------------------------

def load_theme(theme_id):
    """Return (theme, errors). theme = {id, name, mode, colors} when valid."""
    path = os.path.join(THEMES_DIR, theme_id)
    errors = []
    if not ID_RE.match(theme_id):
        errors.append("directory name must match [a-z0-9][a-z0-9-]* (it is the theme id)")
    markers = [m for m in MODES if os.path.isfile(os.path.join(path, m))]
    if len(markers) != 1:
        errors.append("needs exactly one marker file 'dark' or 'light' (found: %s)"
                      % (", ".join(markers) or "none"))
    if not os.path.isdir(os.path.join(path, "backgrounds")):
        errors.append("missing backgrounds/ directory")
    data = None
    try:
        with open(os.path.join(path, "theme.yml"), encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except FileNotFoundError:
        errors.append("missing theme.yml")
    except yaml.YAMLError as e:
        errors.append("theme.yml is not valid YAML: %s" % str(e).splitlines()[0])
    if data is not None:
        if not isinstance(data, dict):
            errors.append("theme.yml must be a mapping")
        else:
            unknown = set(data) - THEME_KEYS
            if unknown:
                errors.append("unknown keys in theme.yml: %s" % ", ".join(sorted(unknown)))
            if not isinstance(data.get("name"), str) or not data.get("name"):
                errors.append("theme.yml needs a non-empty string 'name'")
            for block, keys in (("colors", ROLES), ("terminal", TERMINAL)):
                values = data.get(block)
                if not isinstance(values, dict):
                    errors.append("theme.yml needs a '%s' mapping" % block)
                    continue
                missing = [k for k in keys if k not in values]
                extra = [k for k in values if k not in keys]
                bad = [k for k in keys if k in values
                       and not (isinstance(values[k], str) and HEX_RE.match(values[k]))]
                if missing:
                    errors.append("missing %s: %s" % (block, ", ".join(missing)))
                if extra:
                    errors.append("unknown %s: %s" % (block, ", ".join(extra)))
                if bad:
                    errors.append("%s not #rrggbb: %s" % (block, ", ".join(bad)))
    if errors:
        return None, errors
    return {"id": theme_id, "name": data["name"], "mode": markers[0],
            "colors": {r: data["colors"][r] for r in ROLES},
            "terminal": [data["terminal"][k] for k in TERMINAL]}, []


def discover():
    """Scan the theme directories once. Returns (valid {id: theme}, invalid {id: errors})."""
    valid, invalid = {}, {}
    try:
        entries = sorted(os.listdir(THEMES_DIR))
    except FileNotFoundError:
        raise ThemeError("theme directory %s does not exist" % THEMES_DIR)
    for entry in entries:
        if entry.startswith(".") or not os.path.isdir(os.path.join(THEMES_DIR, entry)):
            continue
        theme, errors = load_theme(entry)
        if theme:
            valid[entry] = theme
        else:
            invalid[entry] = errors
    return valid, invalid


# --- state -----------------------------------------------------------------

def read_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            pairs = dict(line.rstrip("\n").split("=", 1) for line in f if "=" in line)
    except FileNotFoundError:
        return None
    state = {k: pairs.get(k, "") for k in ("dark", "light", "mode")}
    state["wallpapers"] = {k[len("wallpaper."):]: v for k, v in pairs.items()
                           if k.startswith("wallpaper.") and v}
    return state


def backgrounds(theme_id):
    """The theme's wallpaper files (names), sorted - the deterministic order."""
    path = os.path.join(THEMES_DIR, theme_id, "backgrounds")
    try:
        names = os.listdir(path)
    except FileNotFoundError:
        return []
    return sorted(n for n in names if not n.startswith(".")
                  and n.lower().endswith(WALLPAPER_EXT)
                  and os.path.isfile(os.path.join(path, n)))


def wallpaper(state, theme_id):
    """The wallpaper in use for a theme: the remembered choice if it still
    exists, else the first file, else None."""
    files = backgrounds(theme_id)
    choice = state.get("wallpapers", {}).get(theme_id)
    name = choice if choice in files else (files[0] if files else None)
    if name is None:
        return None
    return {"file": name, "path": os.path.join(THEMES_DIR, theme_id, "backgrounds", name),
            "animated": name.lower().endswith(ANIMATED_EXT)}


def wallpaper_list(state):
    tid = state[state["mode"]]
    current = wallpaper(state, tid)
    return {"theme": tid, "selected": current["file"] if current else None,
            "backgrounds": [{"file": n, "path": os.path.join(THEMES_DIR, tid, "backgrounds", n),
                             "animated": n.lower().endswith(ANIMATED_EXT)} for n in backgrounds(tid)]}


def check_state(state, valid):
    if state["mode"] not in MODES:
        raise ThemeError("mode must be dark or light, not %r" % state["mode"])
    for slot in MODES:
        theme = valid.get(state[slot])
        if theme is None:
            raise ThemeError("%s theme %r is not a valid theme" % (slot, state[slot]))
        if theme["mode"] != slot:
            raise ThemeError("%r is a %s theme, not %s" % (state[slot], theme["mode"], slot))


def write_files(files):
    """Atomically replace every {path: text} that differs. All new contents
    are staged as temp files first; only if ALL staged successfully are
    they renamed into place (same-filesystem renames). A failure while
    staging leaves every existing file untouched. Returns changed paths."""
    staged = []
    try:
        for path, text in files.items():
            try:
                with open(path, encoding="utf-8") as f:
                    if f.read() == text:
                        continue
            except FileNotFoundError:
                pass
            os.makedirs(os.path.dirname(path), exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
            staged.append((tmp, path))
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(text)
            os.chmod(tmp, 0o644)
    except BaseException:
        for tmp, _ in staged:
            if os.path.exists(tmp):
                os.unlink(tmp)
        raise
    for tmp, path in staged:
        os.replace(tmp, path)
    return [path for _, path in staged]


def state_text(state):
    return ("".join("%s=%s\n" % (k, state[k]) for k in ("dark", "light", "mode"))
            + "".join("wallpaper.%s=%s\n" % (tid, f)
                      for tid, f in sorted(state.get("wallpapers", {}).items())))


# --- rendering (the only place theme colors are turned into app formats) ---

def render(state, valid):
    theme = valid[state[state["mode"]]]
    c = theme["colors"]
    rgb = {r: "rgb(%s)" % c[r].lstrip("#") for r in ROLES}
    return {
        # Quickshell: Colors.qml reads this (on start and on IPC theme.reload).
        # The wallpaper rides along (null = none: background color).
        "colors.json": json.dumps({"id": theme["id"], "name": theme["name"],
                                   "mode": state["mode"], "colors": c,
                                   "wallpaper": wallpaper(state, theme["id"])}, indent=2) + "\n",
        # Hyprland: hyprland.lua does dofile() on this.
        "hyprland.lua": "-- generated by `theme` - do not edit\nreturn {\n"
                        + "".join('    %s = "%s",\n' % (r, rgb[r]) for r in ROLES) + "}\n",
        # hyprlock: hyprlock.conf sources this.
        "hyprlock.conf": "# generated by `theme` - do not edit\n"
                         + "".join("$%s = %s\n" % (r, rgb[r]) for r in ROLES),
        # Ghostty: config.ghostty includes this (config-file = ?...).
        # Cursor and selection come from the semantic roles (accent =
        # "selection fill", accent_foreground = "text on it"), the 16 ANSI
        # colors from the theme's terminal palette.
        "ghostty": "# generated by `theme` - do not edit\n"
                   + "background = %s\nforeground = %s\n" % (c["background"], c["foreground"])
                   + "cursor-color = %s\ncursor-text = %s\n" % (c["foreground"], c["background"])
                   + "selection-background = %s\nselection-foreground = %s\n" % (c["accent"], c["accent_foreground"])
                   + "".join("palette = %d=%s\n" % (i, v) for i, v in enumerate(theme["terminal"])),
    }


# --- applying live (user level only, best effort, never a lingering process) -

def _session_env():
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=%s/bus" % env["XDG_RUNTIME_DIR"])
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE") or not env.get("WAYLAND_DISPLAY"):
        try:
            out = subprocess.run(["hyprctl", "instances", "-j"], env=env, capture_output=True,
                                 text=True, timeout=5).stdout
            inst = json.loads(out or "[]")
            if inst:
                env.setdefault("HYPRLAND_INSTANCE_SIGNATURE", inst[0]["instance"])
                env.setdefault("WAYLAND_DISPLAY", inst[0]["wl_socket"])
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
    return env


def _run(argv, env):
    try:
        return subprocess.run(argv, env=env, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None


def _signal(name, sig):
    """Send `sig` to every process of ours named `name` (no-op if none)."""
    res = _run(["pgrep", "-u", str(os.getuid()), "-x", name], dict(os.environ))
    for pid in (res.stdout.split() if res is not None else []):
        try:
            os.kill(int(pid), sig)
        except (OSError, ValueError):
            pass


def apply_live(state, changed_files):
    env = _session_env()
    if "ghostty" in changed_files:
        # Ghostty (1.3) reloads its configuration on SIGUSR2 - every open
        # window picks up the new colors, no restart.
        _signal("ghostty", signal.SIGUSR2)
    if "colors.json" in changed_files:
        _run(["qs", "ipc", "--any-display", "call", "theme", "reload"], env)
    if "hyprland.lua" in changed_files and env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        _run(["hyprctl", "reload"], env)
    gtk_changed = False
    want = {"color-scheme": "prefer-%s" % state["mode"],
            "gtk-theme": "Adwaita-dark" if state["mode"] == "dark" else "Adwaita"}
    for key, value in want.items():
        cur = _run(["gsettings", "get", "org.gnome.desktop.interface", key], env)
        if cur is not None and cur.returncode == 0 and cur.stdout.strip() == "'%s'" % value:
            continue
        res = _run(["gsettings", "set", "org.gnome.desktop.interface", key, value], env)
        gtk_changed = gtk_changed or (res is not None and res.returncode == 0)
    return gtk_changed


def commit(state, valid):
    """Validate, render everything, write outputs + state together, then
    apply live. Returns whether anything changed."""
    check_state(state, valid)              # nothing written unless the new state is valid
    outputs = render(state, valid)         # every output exists before anything is written
    files = {os.path.join(OUT_DIR, name): text for name, text in outputs.items()}
    files[STATE_FILE] = state_text(state)  # state is only written together with its outputs
    changed = write_files(files)
    changed_files = [os.path.basename(p) for p in changed if p != STATE_FILE]
    gtk_changed = apply_live(state, changed_files)
    return bool(changed or gtk_changed)


# --- CLI -------------------------------------------------------------------

def usage():
    sys.stderr.write("usage: theme status [--json] | list dark|light | current | toggle |"
                     " mode dark|light | select dark|light <id> | apply [...] | validate |"
                     " wallpaper list | wallpaper set <file>\n")
    return 2


def require_state():
    state = read_state()
    if state is None:
        raise ThemeError("no theme state yet (%s) - run bootstrap.sh once" % STATE_FILE)
    return state


def main(argv):
    if not argv:
        return usage()
    cmd, args = argv[0], argv[1:]
    valid, invalid = discover()

    if cmd == "validate":
        for tid, errors in sorted(invalid.items()):
            for e in errors:
                print("%s: %s" % (tid, e), file=sys.stderr)
        if not valid:
            print("no valid themes in %s" % THEMES_DIR, file=sys.stderr)
        return 1 if invalid or not valid else 0

    if cmd == "status":
        state = read_state()
        status = {
            "state": state,
            "dark": [{"id": t["id"], "name": t["name"]} for t in valid.values() if t["mode"] == "dark"],
            "light": [{"id": t["id"], "name": t["name"]} for t in valid.values() if t["mode"] == "light"],
            "invalid": invalid,
            "wallpaper": wallpaper_list(state) if state and state.get(state["mode"]) in valid else None,
        }
        if args == ["--json"]:
            print(json.dumps(status))
        else:
            print("state: %s" % (state_text(state).replace("\n", " ") if state else "none"))
            for m in MODES:
                print("%s: %s" % (m, ", ".join("%s (%s)" % (t["id"], t["name"]) for t in status[m])))
            for tid, errors in invalid.items():
                print("invalid: %s - %s" % (tid, "; ".join(errors)))
        return 0

    if cmd == "list" and len(args) == 1 and args[0] in MODES:
        for t in valid.values():
            if t["mode"] == args[0]:
                print(t["id"])
        return 0

    if cmd == "current" and not args:
        print(state_text(require_state()).replace("\n", " ").strip())
        return 0

    if cmd == "toggle" and not args:
        state = require_state()
        state["mode"] = "light" if state["mode"] == "dark" else "dark"
        commit(state, valid)
        return 0

    if cmd == "mode" and len(args) == 1 and args[0] in MODES:
        state = require_state()
        state["mode"] = args[0]
        commit(state, valid)
        return 0

    if cmd == "select" and len(args) == 2 and args[0] in MODES:
        state = require_state()
        state[args[0]] = args[1]
        commit(state, valid)
        return 0

    if cmd == "wallpaper" and args == ["list"]:
        state = require_state()
        print(json.dumps(wallpaper_list(state)))
        return 0

    if cmd == "wallpaper" and len(args) == 2 and args[0] == "set":
        state = require_state()
        tid = state[state["mode"]]
        if args[1] not in backgrounds(tid):
            raise ThemeError("%r is not a wallpaper of theme %r (themes/%s/backgrounds/)" % (args[1], tid, tid))
        state["wallpapers"][tid] = args[1]
        commit(state, valid)
        return 0

    if cmd == "apply":
        opts = dict(zip(args[0::2], args[1::2]))
        state = read_state()
        if state is None:
            state = {"dark": opts.get("--init-dark", ""), "light": opts.get("--init-light", ""),
                     "mode": opts.get("--init-mode", ""), "wallpapers": {}}
        print("changed" if commit(state, valid) else "unchanged")
        return 0

    return usage()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except ThemeError as e:
        print("theme: %s" % e, file=sys.stderr)
        sys.exit(1)
    except OSError as e:
        # e.g. an unwritable output dir - write_files() has already
        # discarded its staged files, so the previous theme stays intact.
        print("theme: could not write theme files, nothing changed: %s" % e, file=sys.stderr)
        sys.exit(1)
