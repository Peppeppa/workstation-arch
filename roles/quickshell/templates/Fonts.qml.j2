// Central font source for every Quickshell component - the typography
// counterpart of Colors.qml (see docs/DESIGN_SYSTEM.md). Managed by
// Ansible from roles/quickshell/templates/Fonts.qml.j2; the names come
// from group_vars/all.yml desktop_shell_font_family /
// desktop_icon_font_family (the one place font names are defined for the
// whole desktop) - do not edit by hand.
//
// Components use `font.family: Fonts.family` for text and
// `Fonts.icons` for Nerd Font icon glyphs - never a font name literal.
//
// Text size: ONE runtime preference for the whole desktop, owned by the
// `theme` helper (state `text-size`, `theme text-size <px>`, presets
// 9 10 11 12 14 16 18; Appearance -> Text size). It arrives here with the
// theme data (Colors.data.text_size, re-read on `qs ipc call theme
// reload` - no watcher). Every shell size is written for the default
// size ({{ desktop_ui_font_size }}) and goes through px(): bar
// (BarStyle), popups, OS menu, Appearance, notifications, power menu,
// clipboard - text and the rows/panels holding text scale together.
// Ghostty and GTK get the same preference from the helper.

pragma Singleton

import Quickshell

Singleton {
    readonly property string family: "{{ desktop_shell_font_family }}"
    readonly property string icons: "{{ desktop_icon_font_family }}"

    readonly property int defaultSize: {{ desktop_ui_font_size }}
    readonly property int size: sizeFrom(Colors.data.text_size, defaultSize)
    readonly property real scale: size / defaultSize

    // The text size from the theme data. The theme helper only writes its
    // presets; anything that is not a sane number (a damaged or hand-edited
    // colors.json) falls back to the default instead of 0, which made every
    // shell text 0 px (Bug Hunt v1). Pure (tests).
    function sizeFrom(v, fallback) {
        const n = typeof v === "number" || typeof v === "string" ? Number(v) : NaN;
        return Number.isFinite(n) && n >= 6 && n <= 48 ? Math.round(n) : fallback;
    }

    // A size written for the default text size -> the current one.
    function px(n) {
        return Math.round(n * scale);
    }
}
