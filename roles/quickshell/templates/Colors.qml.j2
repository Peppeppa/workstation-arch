// Central color source for every Quickshell component (see
// docs/DESIGN_SYSTEM.md). GENERATED by Ansible from the active theme
// (roles/theme: themes/{{ theme_active }}.yml, selected by group_vars/all.yml
// theme_dark / theme_light / theme_mode) - do not edit by hand.
//
// Components read these semantic roles only - never a hex literal, never
// a theme name, never their own dark/light branches. A theme switch
// regenerates this file; Quickshell reloads it and every binding follows.
//
// Purely declarative: a QML singleton evaluated at load, no process,
// timer or watcher.

pragma Singleton

import QtQuick
import Quickshell

Singleton {
    readonly property string themeName: "{{ theme_name }}"
    readonly property string mode: "{{ theme_mode }}"

    readonly property color background: "{{ theme_colors.background }}"
    readonly property color surface: "{{ theme_colors.surface }}"
    readonly property color foreground: "{{ theme_colors.foreground }}"
    readonly property color foregroundMuted: "{{ theme_colors.foreground_muted }}"
    readonly property color accent: "{{ theme_colors.accent }}"
    readonly property color accentForeground: "{{ theme_colors.accent_foreground }}"
    readonly property color border: "{{ theme_colors.border }}"
    readonly property color borderActive: "{{ theme_colors.border_active }}"
    readonly property color error: "{{ theme_colors.error }}"
}
