// Quickshell root config. Managed by Ansible: do not edit by hand, see
// roles/quickshell in workstation-arch.
//
// Rendered from roles/quickshell/templates/shell.qml.j2. Owns: one bar per
// monitor (bar/Bar.qml - the bar host; its widgets, their layout and
// popups live in bar/, see docs/feature-architecture.md "Bar"), the app
// launcher (Launcher.qml, `qs ipc call launcher toggle`), the low-battery
// warning, and the optional features composed below (power menu,
// notifications, clipboard history, wallpaper - each inside a Jinja
// if-block on its <name>_enabled flag, so a disabled feature is not even
// instantiated). Optional bar parts are switched by bar/BarFeatures.qml.
//
// Colors come from the Colors singleton (Colors.qml -> active theme, see
// docs/DESIGN_SYSTEM.md); no color is passed down from here.

import QtQuick
import Quickshell
import qs.bar

ShellRoot {
    id: root

    // Font size of the non-bar overlays (launcher, power menu, toasts,
    // clipboard); the bar has its own (bar/BarStyle.qml).
    readonly property int fontSize: 13

    // One bar per connected monitor.
    Variants {
        model: Quickshell.screens

        Bar {}
    }

    // Low-battery warning (core): one instance, not per bar.
    BatteryWatcher {}

    // One launcher instance, placed by the compositor on the focused output.
    Launcher {
        fontSize: root.fontSize
    }
{% if wallpaper_enabled %}

    // FEATURE: wallpaper (group_vars/all.yml wallpaper_enabled): the
    // background layer on every monitor, from the active theme.
    Wallpaper {}
{% endif %}
{% if power_menu_enabled %}

    // FEATURE: power_menu (group_vars/all.yml power_menu_enabled). One
    // instance, placed on the focused monitor like the launcher.
    // hibernateAvailable is this host's logind CanHibernate answer at
    // provisioning time (roles/quickshell/tasks/main.yml) - static, no
    // runtime capability check.
    PowerMenu {
        fontSize: root.fontSize
        hibernateAvailable: {{ 'true' if power_menu_hibernate_available | default(false) | bool else 'false' }}
        // Lock works only with the lock_idle feature (hypridle answers
        // logind's Lock signal).
        lockAvailable: {{ 'true' if lock_idle_enabled else 'false' }}
    }
{% endif %}
{% if clipboard_history_enabled %}

    // FEATURE: clipboard_history (group_vars/all.yml
    // clipboard_history_enabled): popup over cliphist, mainMod+V.
    ClipboardHistory {
        fontSize: root.fontSize
    }
{% endif %}
{% if notifications_enabled %}

    // FEATURE: notifications (group_vars/all.yml notifications_enabled):
    // this process owns org.freedesktop.Notifications and shows toasts.
    Notifications {
        fontSize: root.fontSize
    }
{% endif %}
}
