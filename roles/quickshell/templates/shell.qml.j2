// Quickshell Core Desktop v1 - root config. Managed by Ansible: do not
// edit by hand, see roles/quickshell in workstation-arch.
//
// Rendered from roles/quickshell/templates/shell.qml.j2: optional
// Quickshell features are composed here inside a Jinja if-block on their
// <name>_enabled flag (see docs/feature-architecture.md "Quickshell
// modularity"), so a disabled feature is not even instantiated.
//
// Owns: one top bar per monitor (Bar.qml) and one keyboard-driven app
// launcher (Launcher.qml), toggled via Quickshell's own IPC (see
// Launcher.qml's IpcHandler and roles/hyprland's mainMod+Space bind).
// Optional: the power menu (PowerMenu.qml, power_menu_enabled) and
// notifications (Notifications.qml, notifications_enabled). No tray,
// notification center, Wi-Fi/
// Bluetooth menus, or theme framework yet - see AGENTS.md Next
// Milestone for what's deliberately deferred.
//
// Colors come from the Colors singleton (Colors.qml -> active scheme,
// see docs/DESIGN_SYSTEM.md), which every component reads directly -
// no color is passed down from here. The two size constants below are
// still shared via required properties.

import QtQuick
import Quickshell
import Quickshell.Services.Pipewire

ShellRoot {
    id: root

    readonly property int barHeight: 28
    readonly property int fontSize: 13

    // Native, event-driven clock: SystemClock maintains its own
    // internal timer at the given precision - this never polls `date`.
    // Shared by every Bar instance below via the `clock` property.
    SystemClock {
        id: systemClock
        precision: SystemClock.Minutes
    }

    // Binding (not starting/owning) the current default sink: this is
    // what makes its live audio.volume/audio.muted properties update
    // and settable at all, per Quickshell.Services.Pipewire's own
    // PwObjectTracker docs. Shared globally (Pipewire is a singleton),
    // so one tracker here covers Bar.qml's volume widget on every
    // monitor. Never starts, stops, or reconfigures PipeWire/
    // WirePlumber (roles/audio remains their only lifecycle owner).
    PwObjectTracker {
        objects: Pipewire.defaultAudioSink ? [Pipewire.defaultAudioSink] : []
    }

    // One bar per connected monitor - Quickshell's own normal model for
    // this (Variants over Quickshell.screens) makes it no more complex
    // than a single bar would be.
    Variants {
        model: Quickshell.screens

        Bar {
            // modelData is injected by Variants itself after this
            // delegate is created - do not set it explicitly here (see
            // Bar.qml's own property declaration).
            //
            // Qualified with `root.` throughout: Bar.qml declares its
            // own same-named properties, so an unqualified RHS (e.g.
            // `clock: clock`) would resolve to Bar's own not-yet-set
            // property instead of ShellRoot's - a self-reference
            // binding loop, confirmed the hard way in testing (Qt
            // reported "Binding loop detected" and clock.date read as
            // undefined until this was qualified).
            clock: systemClock
            // Coffee (idle-pause) toggle only with the lock_idle feature.
            idleToggleAvailable: {{ 'true' if lock_idle_enabled else 'false' }}
            themeDialog: themeDialogWindow
            trayEnabled: {{ 'true' if tray_enabled else 'false' }}
            bluetoothEnabled: {{ 'true' if bluetooth_enabled else 'false' }}
            powerProfilesEnabled: {{ 'true' if power_profiles_enabled else 'false' }}
            audioPopupEnabled: {{ 'true' if audio_popup_enabled else 'false' }}
            connectivityEnabled: {{ 'true' if connectivity_enabled else 'false' }}
            barHeight: root.barHeight
            fontSize: root.fontSize
        }
    }

    // Low-battery warning (core): one instance, not per bar.
    BatteryWatcher {}

    // Theme picker (core): one instance, opened from the bar's theme icon.
    ThemeDialog {
        id: themeDialogWindow
        fontSize: root.fontSize
        barHeight: root.barHeight
    }

    // One launcher instance, not one per monitor: it has no preferred
    // screen set, so the compositor places it on whichever output is
    // currently focused (standard wlr-layer-shell behavior for a
    // surface with no output binding) - simpler and more correct for a
    // single modal overlay than guessing which monitor to pin it to.
    Launcher {
        // Qualified with `root.` for the same reason as Bar above.
        fontSize: root.fontSize
    }
{% if power_menu_enabled %}

    // FEATURE: power_menu (group_vars/all.yml power_menu_enabled). One
    // instance, placed on the focused monitor like the launcher.
    // hibernateAvailable is this host's logind CanHibernate answer at
    // provisioning time (roles/quickshell/tasks/main.yml) - static, no
    // runtime capability check.
    PowerMenu {
        fontSize: root.fontSize
        hibernateAvailable: {{ 'true' if power_menu_hibernate_available | default(false) | bool else 'false' }}
        // Lock works only with the lock_idle feature (hypridle answers
        // logind's Lock signal).
        lockAvailable: {{ 'true' if lock_idle_enabled else 'false' }}
    }
{% endif %}
{% if clipboard_history_enabled %}

    // FEATURE: clipboard_history (group_vars/all.yml
    // clipboard_history_enabled): popup over cliphist, mainMod+V.
    ClipboardHistory {
        fontSize: root.fontSize
    }
{% endif %}
{% if notifications_enabled %}

    // FEATURE: notifications (group_vars/all.yml notifications_enabled):
    // this process owns org.freedesktop.Notifications and shows toasts.
    Notifications {
        fontSize: root.fontSize
    }
{% endif %}
}
