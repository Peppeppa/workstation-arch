<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Managed by Ansible (roles/recovery) - do not edit by hand.
     The snapshot-mode dialog's "Dauerhaft wiederherstellen" runs
     `pkexec {{ recovery_restore_helper }} <number>`: it replaces the system (@)
     with the snapshot the machine is booted from (the old @ is kept). That is
     the most far-reaching action of the desktop, so it ALWAYS asks for the
     administrator password - also in the active local session. -->
<policyconfig>
  <action id="{{ recovery_restore_polkit_action }}">
    <description>Restore the booted system snapshot permanently</description>
    <message>Authentication is required to make this snapshot the regular system</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">{{ recovery_restore_helper }}</annotate>
  </action>
</policyconfig>
