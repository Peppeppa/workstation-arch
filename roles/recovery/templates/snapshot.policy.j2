<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Managed by Ansible (roles/recovery) - do not edit by hand.
     OS menu -> System -> Create Snapshot runs `pkexec {{ recovery_snapshot_helper }} set <slot> <label>`:
     the user in the ACTIVE local session (seat) may run exactly this helper as
     root without a password - under this name it only CREATES a snapshot in
     an EMPTY manual slot. Overwrite and delete are {{ recovery_snapshot_delete_helper }}
     ({{ recovery_snapshot_delete_polkit_action }}, administrator password).
     Remote (SSH) or inactive sessions need administrator authentication. -->
<policyconfig>
  <action id="{{ recovery_snapshot_polkit_action }}">
    <description>Manage the manual system snapshot slots</description>
    <message>Authentication is required to manage the manual system snapshots</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">{{ recovery_snapshot_helper }}</annotate>
  </action>
</policyconfig>
