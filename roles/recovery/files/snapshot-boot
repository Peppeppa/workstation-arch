#!/usr/bin/env python3
# Managed by Ansible (roles/recovery/files/snapshot-boot) - do not edit by hand.
# Deployed to /usr/local/lib/workstation/snapshot-boot (root only).
#
# Bootable snapper snapshots in systemd-boot (docs/recovery-design.md 22, 23).
# The class of a snapshot comes from snapper's userdata, never from text:
#   update   auto=pre-transaction + (upgrade=yes | update=<id>): taken before
#            a system upgrade (the pacman hook saw -S..u / --sysupgrade, or
#            system-update) - kept: the newest UPDATE_KEEP (+ the newest
#            bootable one if none of those boots), all offered in the menu
#   other    auto=pre-transaction otherwise (installs/removals): kept: the
#            newest OTHER_KEEP, never in the menu
#   manual   mslot=1|2|3 - the three manual slots (Create Snapshot), at most
#            one snapshot each, cleanup algorithm "" (snapper never removes
#            them), removed only by slot-delete or a confirmed overwrite
# Never deleted here: manual slots, legacy recovery slots (slot=), the
# baseline, snapshots without a class, the booted snapshot (nothing runs in
# a snapshot boot). Slot metadata lives in snapper's own info.xml
# (@snapshots, outside @) - a rollback cannot lose it.
#
#   snapshot-boot capture   store the main UKI for its kernel version
#                           (/boot/EFI/workstation/snapshots/<uname>.efi) -
#                           run synchronously before a snapshot is taken (the
#                           pacman hook: a kernel update rebuilds the main UKI
#                           minutes later, the old snapshot needs the old one)
#   snapshot-boot sync      the entries: write the chosen ones, remove every
#                           other workstation-snapshot-*.conf, delete UKI copies
#                           nothing uses any more, write the state file
#   snapshot-boot sync --queued
#                           the service form: repeat while a snapper event
#                           arrived during the run (the plugin's dirty flag)
#   snapshot-boot status [--json]
#   snapshot-boot prune      retention of the update/other classes (pacman hook,
#                            system-update - right after their new snapshot)
#   snapshot-boot check N    exit 0 if snapshot N can boot (reason on stderr)
#   snapshot-boot slot-list [--json]        the three slots (no root needed:
#                            reads /.snapshots/*/info.xml and the state file)
#   snapshot-boot slot-set S LABEL [--replace N]   new snapshot into slot S;
#                            an occupied slot only with --replace <its number>
#                            (the number the user confirmed): create, check it
#                            can boot, move the slot, THEN delete the old one
#   snapshot-boot slot-delete S N           remove slot S's snapshot N
#
# A snapshot is offered only when it can really boot: it exists, is
# read-only, carries this mechanism (SUPPORT marker - its own restore helper
# and pacman block are then inside it), has exactly the one kernel whose UKI
# copy exists, and that UKI's initramfs has the overlay hook. Otherwise the
# reason is in the state file (/var/lib/workstation/snapshot-boot.json,
# world-readable for repo-healthcheck) and the journal (-t snapshot-boot).
#
# An entry boots the stored UKI with its command line replaced (systemd-stub
# takes the loader's command line while Secure Boot is off - `sync` offers
# no entry at all with Secure Boot on): rootflags=subvol=@snapshots/<n>/snapshot, no resume, noresume,
# workstation.snapshot=<n> (the overlay hook's trigger and the shell's
# snapshot-mode marker), systemd.mask=systemd-remount-fs.service (the
# snapshot's fstab line for / names @ - remounting the overlay with it fails).
# The normal entry (arch-linux.efi, loader.conf default) is never touched.
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

R = os.environ.get("SNAPSHOT_BOOT_TEST_ROOT", "")     # tests only: a fake filesystem root
ESP = R + "/boot"
MAIN_UKI = ESP + "/EFI/Linux/arch-linux.efi"
UKI_DIR = ESP + "/EFI/workstation/snapshots"
UKI_REL = "/EFI/workstation/snapshots"
ENTRY_DIR = ESP + "/loader/entries"
ENTRY_PREFIX = "workstation-snapshot-"
SNAPSHOTS = R + "/.snapshots"
STATE = R + "/var/lib/workstation/snapshot-boot.json"
DIRTY = R + "/run/workstation-recovery/snapshot-boot.dirty"
LOCK = R + "/run/lock/workstation-snapshot-boot.lock"
SUPPORT = "usr/local/lib/workstation/snapshot-boot-support"
SUPPORT_MIN = 2      # version 1: its system-rollback asked snapper, which fails in a snapshot boot
HOOK = "workstation-snapshot-overlay"
UPDATE_KEEP = 2                        # update recovery snapshots (all of them in the menu)
OTHER_KEEP = 2                         # other pacman snapshots (installs/removals; not in the menu)
SLOTS = (1, 2, 3)                      # manual slots
ESP_RESERVE = 150 * 1024 * 1024        # never fill the ESP below this (system-update's own limit)

log_lines = []


def log(msg, err=False):
    log_lines.append(msg)
    print("snapshot-boot: " + msg, file=sys.stderr)      # stdout stays free for --json results
    # under systemd (the sync service) stdout/stderr already are the journal
    if not R and not os.environ.get("INVOCATION_ID"):
        subprocess.run(["logger", "-t", "snapshot-boot", "-p", "user.err" if err else "user.info", "--", msg], check=False)


def run(argv, **kw):
    return subprocess.run(argv, capture_output=True, text=True, **kw)


def section(path, name):
    """A PE section of a UKI as bytes (objcopy, binutils) - b"" when missing."""
    with tempfile.NamedTemporaryFile() as t:
        r = run(["objcopy", "-O", "binary", "--only-section=." + name, path, t.name])
        return open(t.name, "rb").read() if r.returncode == 0 else b""


def uki_uname(path):
    return section(path, "uname").decode(errors="replace").strip("\0").strip()


def has_hook(path):
    """Does this UKI's initramfs contain the overlay hook? (lsinitcpio lists it)"""
    initrd = section(path, "initrd")
    if not initrd:
        return False
    with tempfile.NamedTemporaryFile() as t:
        t.write(initrd)
        t.flush()
        r = run(["lsinitcpio", "-l", t.name])
    return r.returncode == 0 and any(l.rstrip("/").endswith("hooks/" + HOOK) for l in r.stdout.splitlines())


def same_file(a, b):
    try:
        if os.path.getsize(a) != os.path.getsize(b):
            return False
        with open(a, "rb") as fa, open(b, "rb") as fb:
            while True:
                x, y = fa.read(1 << 20), fb.read(1 << 20)
                if x != y:
                    return False
                if not x:
                    return True
    except OSError:
        return False


def esp_free():
    st = os.statvfs(ESP)
    return st.f_bavail * st.f_frsize


def write_atomic(path, data, mode=0o600):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "wb" if isinstance(data, bytes) else "w") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def booted_main():
    """The main UKI is the one this system booted: same kernel as running, not rebuilt since the boot."""
    try:
        with open(R + "/proc/stat") as f:
            btime = int(next(l for l in f if l.startswith("btime")).split()[1])
    except (OSError, StopIteration, ValueError):
        return False
    return (os.path.isfile(MAIN_UKI) and uki_uname(MAIN_UKI) == os.uname().release
            and os.stat(MAIN_UKI).st_mtime < btime)


SECURE_BOOT_VAR = R + "/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c"


def secure_boot():
    """Secure Boot on? (EFI variable: 4 attribute bytes, then 1 = on)"""
    try:
        with open(SECURE_BOOT_VAR, "rb") as f:
            return f.read()[4:5] == b"\x01"
    except OSError:
        return False


def snapshot_mode():
    try:
        with open(R + "/proc/cmdline") as f:
            m = re.search(r"(?:^|\s)workstation\.snapshot=(\d+)(?:\s|$)", f.read())
        return int(m.group(1)) if m else None
    except OSError:
        return None


# --- capture ---------------------------------------------------------------

def capture():
    """Store the main UKI for its kernel version. Keeps an existing copy unless
    it lacks the overlay hook, or the main UKI is the proven (booted) one and
    differs - an untested, freshly rebuilt UKI never replaces a working copy.
    -> (ok, message)"""
    if snapshot_mode() is not None:
        return True, "snapshot mode: nothing captured"
    if not os.path.isfile(MAIN_UKI):
        return False, "no main UKI %s" % MAIN_UKI
    uname = uki_uname(MAIN_UKI)
    if not uname:
        return False, "main UKI has no .uname section"
    dest = os.path.join(UKI_DIR, uname + ".efi")
    if os.path.isfile(dest):
        if same_file(dest, MAIN_UKI):
            return True, "UKI for %s already stored" % uname
        if has_hook(dest) and not booted_main():
            return True, "UKI for %s kept (the main UKI was rebuilt since the boot - not proven yet)" % uname
    if not has_hook(MAIN_UKI):
        return False, "main UKI (%s) has no %s hook in its initramfs - mkinitcpio -P first" % (uname, HOOK)
    need = os.path.getsize(MAIN_UKI) - (os.path.getsize(dest) if os.path.isfile(dest) else 0)
    if esp_free() - need < ESP_RESERVE:
        return False, "ESP budget: storing the UKI for %s would leave less than %d MiB free" % (uname, ESP_RESERVE >> 20)
    os.makedirs(UKI_DIR, exist_ok=True)
    tmp = dest + ".tmp"
    shutil.copyfile(MAIN_UKI, tmp)
    with open(tmp, "rb") as f:
        os.fsync(f.fileno())
    os.chmod(tmp, 0o600)
    os.replace(tmp, dest)
    return True, "stored the UKI for %s" % uname


# --- sync ------------------------------------------------------------------

def snapper_list():
    r = run(["snapper", "--jsonout", "-c", "root", "list"])
    if r.returncode != 0:
        raise RuntimeError("snapper list failed: %s" % (r.stderr.strip() or r.returncode))
    return json.loads(r.stdout).get("root", [])


def classify(s):
    ud = s.get("userdata") or {}
    if ud.get("slot") or ud.get("baseline"):
        return None                     # legacy recovery slot / baseline: never ours to touch
    if str(ud.get("mslot", "")) in ("1", "2", "3"):
        return "manual"
    if ud.get("auto") == "pre-transaction":
        return "update" if ud.get("upgrade") == "yes" or ud.get("update") else "other"
    return None


def slot_of(s):
    return int((s.get("userdata") or {})["mslot"])


def snapshot_kernels(snap):
    mod = os.path.join(snap, "usr/lib/modules")
    try:
        return sorted(k for k in os.listdir(mod) if os.path.isfile(os.path.join(mod, k, "vmlinuz")))
    except OSError:
        return []


def is_readonly(snap):
    if R:
        return not os.path.exists(snap + ".rw")    # tests: a ".rw" marker means writable
    r = run(["btrfs", "property", "get", snap, "ro"])
    return r.returncode == 0 and r.stdout.strip() == "ro=true"


def entry_cmdline(snap, n):
    try:
        with open(os.path.join(snap, "etc/kernel/cmdline")) as f:
            base = f.read().strip()
    except OSError:
        return None, "no /etc/kernel/cmdline in the snapshot"
    toks = base.split()
    if "rootflags=subvol=@" not in toks:
        return None, "its /etc/kernel/cmdline has no rootflags=subvol=@"
    out = []
    for t in toks:
        if t == "rootflags=subvol=@":
            t = "rootflags=subvol=@snapshots/%d/snapshot" % n
        elif t.startswith("resume=") or t.startswith("resume_offset="):
            continue
        out.append(t)
    out += ["noresume", "systemd.mask=systemd-remount-fs.service", "workstation.snapshot=%d" % n]
    return " ".join(out), None


hook_cache = {}


def bootable(s, ukis):
    """-> (info dict, None) or (None, reason)."""
    n = s["number"]
    snap = os.path.join(SNAPSHOTS, str(n), "snapshot")
    slot = (s.get("userdata") or {}).get("slot")
    if slot and os.path.isfile(os.path.join(ENTRY_DIR, "workstation-recovery-%s.conf" % slot)):
        return None, "already in the boot menu as recovery slot %s" % slot
    if not os.path.isdir(snap):
        return None, "snapshot directory missing"
    if not is_readonly(snap):
        return None, "snapshot is writable (not read-only)"
    if not os.path.isfile(os.path.join(snap, SUPPORT)):
        return None, "taken before snapshot boot support (no %s inside)" % SUPPORT
    try:
        ver = int([l for l in open(os.path.join(snap, SUPPORT)) if l.strip() and not l.startswith("#")][0])
    except (OSError, ValueError, IndexError):
        ver = 0
    if ver < SUPPORT_MIN:
        return None, "snapshot boot support version %d inside, %d needed (its restore cannot work)" % (ver, SUPPORT_MIN)
    kernels = snapshot_kernels(snap)
    if len(kernels) != 1:
        return None, "needs exactly one kernel in /usr/lib/modules, found %d" % len(kernels)
    kver = kernels[0]
    uki = ukis.get(kver)
    if not uki:
        return None, "no stored UKI for its kernel %s" % kver
    if uki not in hook_cache:
        hook_cache[uki] = has_hook(uki) and uki_uname(uki) == kver
    if not hook_cache[uki]:
        return None, "stored UKI for %s lacks the overlay hook or names another kernel" % kver
    cmdline, why = entry_cmdline(snap, n)
    if not cmdline:
        return None, why
    return {"kver": kver, "uki": uki, "cmdline": cmdline}, None


def clean_text(t, limit):
    t = re.sub(r"[\x00-\x1f\x7f]", " ", t or "").strip()
    return t if len(t) <= limit else t[:limit - 3].rstrip() + "..."


def entry_text(s, cls, info):
    date = (s.get("date") or "")[:16]
    # the number keeps two snapshots of the same minute apart (systemd-boot
    # would otherwise append the file name to identical titles)
    if cls == "manual":
        title = "Slot %d: %s - %s (#%d)" % (slot_of(s), clean_text(s.get("description"), 50), date, s["number"])
        key = "zz-workstation-snapshot-b-slot%d" % slot_of(s)
    else:
        title = "Update snapshot %s - %s (#%d)" % (date, clean_text(s.get("description"), 50), s["number"])
        key = "zz-workstation-snapshot-a-%07d" % (9999999 - s["number"])
    return ("# Managed by snapshot-boot (roles/recovery) - do not edit; rewritten on every snapper change.\n"
            "title    %s\n"
            "sort-key %s\n"
            "uki      %s/%s\n"
            "options  %s\n") % (title, key, UKI_REL, os.path.basename(info["uki"]), info["cmdline"])


def stored_ukis():
    ukis = {}
    if os.path.isdir(UKI_DIR):
        for f in os.listdir(UKI_DIR):
            if f.endswith(".efi"):
                ukis[f[:-4]] = os.path.join(UKI_DIR, f)
    return ukis


def snapper_delete(numbers):
    """Delete snapshots; -> (ok, error text). Never called for an empty list."""
    r = run(["snapper", "-c", "root", "delete"] + [str(n) for n in numbers])
    return r.returncode == 0, (r.stderr.strip() or r.stdout.strip())


# --- retention -------------------------------------------------------------

def prune_plan(snaps, ukis):
    """-> sorted numbers to delete: update class beyond the newest UPDATE_KEEP
    (keeping the newest bootable one if none of those can boot - a failed new
    snapshot never costs the last working recovery point), other class beyond
    the newest OTHER_KEEP. Nothing outside these two classes."""
    upd = sorted((x for x in snaps if classify(x) == "update"), key=lambda x: x["number"], reverse=True)
    oth = sorted((x for x in snaps if classify(x) == "other"), key=lambda x: x["number"], reverse=True)
    keep = upd[:UPDATE_KEEP]
    if not any(bootable(x, ukis)[0] for x in keep):
        rest = [x for x in upd[UPDATE_KEEP:] if bootable(x, ukis)[0]]
        keep += rest[:1]
    gone = [x["number"] for x in upd if x not in keep] + [x["number"] for x in oth[OTHER_KEEP:]]
    return sorted(gone)


def prune():
    if snapshot_mode() is not None:
        log("snapshot mode: no retention from here")
        return 0
    with lock():
        gone = prune_plan(snapper_list(), stored_ukis())
        if not gone:
            return 0
        ok, err = snapper_delete(gone)
        if not ok:
            log("retention: could not delete %s: %s" % (", ".join(map(str, gone)), err), err=True)
            return 1
        log("retention: removed snapshot(s) %s" % ", ".join(map(str, gone)))
        return 0


def check(n):
    snaps = {x["number"]: x for x in snapper_list()}
    if n not in snaps:
        print("snapshot %d does not exist" % n, file=sys.stderr)
        return 1
    info, why = bootable(snaps[n], stored_ukis())
    if info is None:
        print(why, file=sys.stderr)
        return 1
    print("snapshot %d can boot (kernel %s)" % (n, info["kver"]))
    return 0


# --- manual slots ----------------------------------------------------------

def lock():
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    f = open(LOCK, "w")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def read_info(path):
    """snapper's info.xml -> the snapper-list shape (date converted from UTC to local)."""
    import xml.etree.ElementTree as ET
    root = ET.parse(path).getroot()
    date = root.findtext("date") or ""
    try:
        import calendar
        date = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(calendar.timegm(time.strptime(date, "%Y-%m-%d %H:%M:%S"))))
    except ValueError:
        pass
    ud = {u.findtext("key"): u.findtext("value") for u in root.findall("userdata")}
    return {"number": int(root.findtext("num") or -1), "date": date, "description": root.findtext("description") or "",
            "cleanup": root.findtext("cleanup") or "", "userdata": ud or None}


def info_list():
    out = []
    try:
        names = os.listdir(SNAPSHOTS)
    except OSError:
        return out
    for d in names:
        p = os.path.join(SNAPSHOTS, d, "info.xml")
        if d.isdigit() and os.path.isfile(p):
            try:
                out.append(read_info(p))
            except Exception:     # a half-written info.xml: skip, never fail the listing
                pass
    return out


def slot_view(snaps):
    """{slot: {"snapshot": newest holder or None, "duplicates": [older holders], "pending": [mslot-new]}}"""
    view = {k: {"snapshot": None, "duplicates": [], "pending": []} for k in SLOTS}
    for x in sorted(snaps, key=lambda x: x["number"], reverse=True):
        ud = x.get("userdata") or {}
        if classify(x) == "manual":
            v = view[slot_of(x)]
            if v["snapshot"] is None:
                v["snapshot"] = x
            else:
                v["duplicates"].append(x)
        elif str(ud.get("mslot-new", "")) in ("1", "2", "3"):
            view[int(ud["mslot-new"])]["pending"].append(x)
    return view


def slot_list(as_json):
    """No root needed: info.xml is world-readable, bootability from the state file."""
    view = slot_view(info_list())
    try:
        st = json.load(open(STATE))
    except (OSError, ValueError):
        st = {}
    offered = {e["number"] for e in st.get("entries", [])}
    reasons = {e["number"]: e["reason"] for e in st.get("skipped", [])}
    rows = []
    for k in SLOTS:
        x = view[k]["snapshot"]
        if x is None:
            rows.append({"slot": k, "empty": True})
            continue
        n = x["number"]
        status = "bootable" if n in offered else ("not-bootable" if n in reasons else "unknown")
        rows.append({"slot": k, "empty": False, "number": n, "description": x["description"], "date": x["date"][:16],
                     "status": status, "reason": reasons.get(n, "" if n in offered else "not synced yet"),
                     "duplicates": [d["number"] for d in view[k]["duplicates"]]})
    if as_json:
        print(json.dumps({"slots": rows}, ensure_ascii=False))
    else:
        for r in rows:
            print("slot %d  %s" % (r["slot"], "empty" if r["empty"] else "#%d %s  %s  [%s%s]" % (
                r["number"], r["date"], r["description"], r["status"], ": " + r["reason"] if r["reason"] and r["status"] != "bootable" else "")))
    return 0


class SlotError(Exception):
    pass


def booted_normally():
    if snapshot_mode() is not None:
        return False
    if R:
        return True
    r = run(["findmnt", "-no", "OPTIONS", "/"])
    return re.search(r"(^|,)subvol=/@(,|$)", r.stdout.strip()) is not None


def slot_set(k, label, replace):
    """New snapshot into slot k. Order: create (pending) -> check it can boot ->
    move the slot -> delete the old -> sync. Any failure before the move leaves
    the slot as it was (the new snapshot is deleted again)."""
    if not booted_normally():
        raise SlotError("only from the normal system (not in a snapshot or recovery boot)")
    with lock():
        snaps = snapper_list()
        v = slot_view(snaps)[k]
        cur = v["snapshot"]
        if cur is not None and replace != cur["number"]:
            raise SlotError("slot %d holds snapshot %d (%s) - overwrite it only after confirming that one"
                            % (k, cur["number"], cur.get("description", "")))
        if cur is None and replace is not None:
            raise SlotError("slot %d is empty now (was %d) - reload and try again" % (k, replace))
        leftovers = [x["number"] for x in v["pending"]]
        if leftovers:
            snapper_delete(leftovers)
        ok, msg = capture()
        if not ok:
            raise SlotError("cannot make the snapshot bootable: %s" % msg)
        r = run(["snapper", "-c", "root", "create", "--type", "single", "--print-number", "--cleanup-algorithm", "",
                 "--description", label, "--userdata", "important=yes,mslot-new=%d" % k])
        lines = r.stdout.strip().splitlines()
        if r.returncode != 0 or not lines or not lines[-1].strip().isdigit():
            raise SlotError("snapper could not create the snapshot: %s" % (r.stderr.strip() or r.stdout.strip() or r.returncode))
        n = int(lines[-1])
        new = {x["number"]: x for x in snapper_list()}.get(n)
        info, why = bootable(new, stored_ukis()) if new else (None, "not in the snapper list after creation")
        if info is None:
            snapper_delete([n])
            raise SlotError("the new snapshot cannot boot (%s) - removed again, slot %d unchanged" % (why, k))
        r = run(["snapper", "-c", "root", "modify", "--userdata", "mslot=%d,mslot-new=" % k, str(n)])
        if r.returncode != 0:
            snapper_delete([n])
            raise SlotError("could not assign snapshot %d to slot %d: %s - removed again, slot unchanged" % (n, k, r.stderr.strip()))
        warnings = []
        old = ([cur["number"]] if cur else []) + [x["number"] for x in v["duplicates"]]
        if old:
            ok, err = snapper_delete(old)
            if not ok:
                warnings.append("old snapshot %s not deleted (%s) - the slot shows the new one" % (", ".join(map(str, old)), err))
        try:
            sync_once()
        except Exception as e:
            warnings.append("boot menu not synced: %s" % e)
        log("slot %d: snapshot %d \"%s\"%s" % (k, n, label, " (replaced %d)" % cur["number"] if cur else ""))
        made = {x["number"]: x for x in snapper_list()}.get(n, {})
        return {"ok": True, "slot": k, "number": n, "description": label, "date": (made.get("date") or "")[:16],
                "replaced": cur["number"] if cur else None, "warnings": warnings}


def slot_delete(k, n):
    if snapshot_mode() is not None:
        raise SlotError("not in a snapshot boot (snapshot %d is running)" % snapshot_mode())
    with lock():
        v = slot_view(snapper_list())[k]
        cur = v["snapshot"]
        if cur is None or cur["number"] != n:
            raise SlotError("slot %d does not hold snapshot %d (now: %s) - reload and try again"
                            % (k, n, cur["number"] if cur else "empty"))
        ok, err = snapper_delete([n] + [x["number"] for x in v["duplicates"] + v["pending"]])
        if not ok:
            raise SlotError("snapper could not delete snapshot %d: %s" % (n, err))
        warnings = []
        try:
            sync_once()
        except Exception as e:
            warnings.append("boot menu not synced: %s" % e)
        log("slot %d: snapshot %d deleted" % (k, n))
        return {"ok": True, "slot": k, "deleted": n, "warnings": warnings}


def sync_once():
    ok_cap, msg = capture()
    log(msg, err=not ok_cap)
    snaps = snapper_list()
    ukis = stored_ukis()
    chosen, skipped = [], []
    count = {"update": 0}
    slot_taken = set()
    errors = [] if ok_cap else [msg]
    if secure_boot():
        # systemd-stub ignores the entry's command line then: an entry would boot @
        errors.append("Secure Boot is on: systemd-stub ignores an entry's command line - no snapshot entries")
        snaps = []
    for s in sorted(snaps, key=lambda s: s["number"], reverse=True):
        cls = classify(s)
        if cls not in ("update", "manual") or s["number"] == 0:
            continue
        if cls == "update" and count["update"] >= UPDATE_KEEP:
            continue
        if cls == "manual" and slot_of(s) in slot_taken:
            continue                    # an older duplicate of a slot (interrupted overwrite): the newest holds it
        if cls == "manual":
            slot_taken.add(slot_of(s))
        info, why = bootable(s, ukis)
        if info is None:
            skipped.append({"number": s["number"], "class": cls, "date": s.get("date"),
                            "description": s.get("description"), "reason": why,
                            "slot": slot_of(s) if cls == "manual" else None})
            continue
        if cls == "update":
            count["update"] += 1
        chosen.append({"number": s["number"], "class": cls, "date": s.get("date"),
                       "slot": slot_of(s) if cls == "manual" else None,
                       "description": s.get("description"), "kver": info["kver"],
                       "uki": os.path.basename(info["uki"]),
                       "entry": ENTRY_PREFIX + "%d.conf" % s["number"], "text": entry_text(s, cls, info)})
    # entries: write the chosen (only when changed), remove every other one of ours
    os.makedirs(ENTRY_DIR, exist_ok=True)
    want = {c["entry"]: c["text"] for c in chosen}
    for name, text in want.items():
        p = os.path.join(ENTRY_DIR, name)
        try:
            same = open(p).read() == text
        except OSError:
            same = False
        if not same:
            write_atomic(p, text)
            log("entry %s written" % name)
    for f in os.listdir(ENTRY_DIR):
        if f.startswith(ENTRY_PREFIX) and f not in want:
            os.unlink(os.path.join(ENTRY_DIR, f))
            log("entry %s removed" % f)
    # UKI copies: a copy stays while ANY kept update snapshot or slot
    # snapshot has its kernel - offered in the menu or not (a run without
    # entries, e.g. Secure Boot on, must not make them unbootable for good) -
    # and the main kernel's (future snapshots). No clean-up after an error.
    keep = {c["uki"] for c in chosen}
    for x in snaps:
        if classify(x) in ("update", "manual"):
            keep.update(k + ".efi" for k in snapshot_kernels(os.path.join(SNAPSHOTS, str(x["number"]), "snapshot")))
    main_uname = uki_uname(MAIN_UKI) if os.path.isfile(MAIN_UKI) else ""
    if main_uname:
        keep.add(main_uname + ".efi")
    removed = []
    for f in sorted(os.listdir(UKI_DIR)) if os.path.isdir(UKI_DIR) and not errors else []:
        if f.endswith(".efi") and f not in keep:
            os.unlink(os.path.join(UKI_DIR, f))
            removed.append(f)
    if removed:
        log("unused UKI copies removed: %s" % ", ".join(removed))
    for c in chosen:
        del c["text"]
    state = {"version": 1, "time": int(time.time()), "ok": not errors, "capture": msg, "entries": chosen,
             "skipped": skipped, "uki_files": sorted(os.listdir(UKI_DIR)) if os.path.isdir(UKI_DIR) else [],
             "esp_free_bytes": esp_free(), "esp_reserve_bytes": ESP_RESERVE, "errors": errors}
    write_atomic(STATE, json.dumps(state, indent=1, ensure_ascii=False) + "\n", 0o644)
    return state


def sync(queued):
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        if snapshot_mode() is not None:
            log("snapshot mode (workstation.snapshot=%d): boot entries are not changed from here" % snapshot_mode())
            return 0
        for _ in range(10):
            if queued:
                try:
                    os.unlink(DIRTY)
                except FileNotFoundError:
                    pass
            try:
                st = sync_once()
            except Exception as e:      # one failed run: say so, keep the old entries
                log("sync failed: %s" % e, err=True)
                try:
                    old = json.load(open(STATE))
                except (OSError, ValueError):
                    old = {"version": 1, "entries": [], "skipped": []}
                old.update(time=int(time.time()), ok=False, errors=["sync failed: %s" % e])
                write_atomic(STATE, json.dumps(old, indent=1, ensure_ascii=False) + "\n", 0o644)
                return 1
            if not queued or not os.path.exists(DIRTY):
                break
        log("%d entr%s: %s" % (len(st["entries"]), "y" if len(st["entries"]) == 1 else "ies",
                                ", ".join("#%d" % e["number"] for e in st["entries"]) or "-"))
        return 0 if st["ok"] else 1


def status(as_json):
    try:
        st = json.load(open(STATE))
    except (OSError, ValueError):
        print("no state yet (%s)" % STATE)
        return 1
    if as_json:
        print(json.dumps(st))
        return 0
    print("synced %s, %s" % (time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(st["time"])), "ok" if st.get("ok") else "ERRORS"))
    for e in st.get("entries", []):
        print("  boot  #%-4d %-6s %s  %s  (kernel %s)" % (e["number"], e["class"], e["date"], e["description"], e["kver"]))
    for e in st.get("skipped", []):
        print("  skip  #%-4d %-6s %s" % (e["number"], e["class"], e["reason"]))
    for e in st.get("errors", []):
        print("  error %s" % e)
    print("  UKI copies: %s; ESP free %d MiB" % (", ".join(st.get("uki_files", [])) or "-", st.get("esp_free_bytes", 0) >> 20))
    return 0 if st.get("ok") else 1


def main(argv):
    if argv[:1] == ["status"] and argv[1:] in ([], ["--json"]):
        return status(argv[1:] == ["--json"])
    if argv[:1] == ["slot-list"] and argv[1:] in ([], ["--json"]):
        return slot_list(argv[1:] == ["--json"])
    if os.geteuid() != 0 and not R:
        print("snapshot-boot: run as root", file=sys.stderr)
        return 1
    if argv == ["capture"]:
        ok, msg = capture()
        log(msg, err=not ok)
        return 0 if ok else 1
    if argv in (["sync"], ["sync", "--queued"]):
        return sync(argv == ["sync", "--queued"])
    if argv == ["prune"]:
        return prune()
    if len(argv) == 2 and argv[0] == "check" and argv[1].isdigit():
        return check(int(argv[1]))
    try:
        if argv[:1] == ["slot-set"] and len(argv) in (3, 5) and argv[1] in ("1", "2", "3") and argv[2] \
                and (len(argv) == 3 or (argv[3] == "--replace" and argv[4].isdigit())):
            res = slot_set(int(argv[1]), argv[2], int(argv[4]) if len(argv) == 5 else None)
            print(json.dumps(res, ensure_ascii=False))
            return 0
        if argv[:1] == ["slot-delete"] and len(argv) == 3 and argv[1] in ("1", "2", "3") and argv[2].isdigit():
            print(json.dumps(slot_delete(int(argv[1]), int(argv[2])), ensure_ascii=False))
            return 0
    except SlotError as e:
        log(str(e), err=True)
        return 1
    print("usage: snapshot-boot capture | sync [--queued] | status [--json] | prune | check N | slot-list [--json]"
          " | slot-set SLOT LABEL [--replace N] | slot-delete SLOT N", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
