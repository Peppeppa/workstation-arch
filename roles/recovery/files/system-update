#!/bin/bash
# Managed by Ansible (roles/recovery/files/system-update) - do not edit by hand.
#
# system-update [--force] [--ui] [--no-snapshot]
#                           the update transaction (docs/recovery-design.md 6)
#
#   1 preflight         booted from @ with the UKI it booted; free space; ESP;
#                       battery/AC; no pacman lock
#   2 repo-healthcheck  before (a FAIL stops, --force goes on anyway)
#   3 snapshot          THE pre-transaction snapshot (the pacman hook skips
#                       its own for this update), the booted UKI stored for
#                       it - the boot menu offers it as "Snapshot (before
#                       update) <date> - system-update ..." (snapshot-boot)
#   4 pacman -Syu       interactive, as always
#   5 UKI sanity, repo-healthcheck --since <start> (no post snapshot)
#
# Never rolls back by itself: a failure leaves diagnostics and the choices
# (boot the snapshot from the boot menu and restore it there, or
# `sudo system-rollback <snapshot>`). Run as the desktop user (sudo is asked for once); the
# health checks run as that user, everything else as root.
#
# Exit: 0 updated + healthy, 1 failed (anything), 2 usage, 3 ONLY the
# pre-update snapshot failed - nothing was changed, pacman never ran.
#   --no-snapshot  the one way past exit 3: no new snapshot/slot for this
#                  update (the pacman hook is told to skip its own too); the
#                  decision goes to the journal (system-update) and the result
#                  says so. Every other check (preflight: pacman lock, space,
#                  boot state; sudo; health) still stops the update.
#   --ui           started by the updater dialog (Quickshell, in a terminal):
#                  reports the outcome back over Quickshell's IPC (`updates`
#                  target: snapshotFailed / finished) and keeps the window
#                  open at the end. Nothing else differs.
# One system-update at a time (flock on $XDG_RUNTIME_DIR/system-update.lock).
set -euo pipefail

force=0 ui=0 nosnap=0
for arg in "$@"; do
    case $arg in
        --force) force=1 ;;
        --ui) ui=1 ;;
        --no-snapshot) nosnap=1 ;;
        *) echo "usage: system-update [--force] [--ui] [--no-snapshot]" >&2; exit 2 ;;
    esac
done
[ "$(id -u)" -ne 0 ] || { echo "system-update: run as your user, not root (it uses sudo itself)" >&2; exit 1; }

say() { printf '\n==> %s\n' "$*"; }
fail() { printf '\nsystem-update: %s\n' "$*" >&2; exit 1; }
root() { sudo /usr/local/lib/workstation/system-update-root "$@"; }

# --ui: tell the updater dialog (no-op without a running Quickshell).
ui_call() { [ "$ui" -eq 1 ] || return 0; qs ipc --any-display call updates "$@" >/dev/null 2>&1 || true; }
pre=none
reported=0
on_exit() {
    local rc=$?
    if [ "$reported" -eq 0 ]; then ui_call finished "$rc" "$pre"; fi
    if [ "$ui" -eq 1 ] && [ -t 0 ]; then
        printf '\nPress Enter to close this window.'
        read -r _ || true
    fi
}
trap on_exit EXIT

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/system-update.lock"
flock -n 9 || fail "another system-update is already running"

health() { # args for repo-healthcheck; prints its result, returns its exit code
    local mode=()
    [ -n "${WAYLAND_DISPLAY:-}" ] || mode=(--system)
    repo-healthcheck "${mode[@]}" "$@"
}

sudo -v
T0=$(date +%s)

say "preflight"
root preflight

say "repo-healthcheck (before)"
if ! health; then
    [ "$force" -eq 1 ] || fail "the system is not healthy before the update - fix it first (repo-diagnose), or run system-update --force"
    echo "(--force: going on despite the failed checks)"
fi

if [ "$nosnap" -eq 1 ]; then
    say "NO pre-update snapshot (--no-snapshot: your decision after a failed snapshot)"
    root skipsnapshot "system-update --no-snapshot: the user chose to update without a pre-update snapshot"
else
    say "pre-update snapshot"
    errf=$(mktemp)
    if ! pre=$(root pre "$T0" 2>"$errf"); then
        cat "$errf" >&2
        why=$(grep -v '^$' "$errf" | tail -1)
        rm -f "$errf"
        pre=none
        printf '\nsystem-update: the pre-update snapshot FAILED - nothing was updated.\n' >&2
        printf '  %s\n' "${why:-snapper failed}" >&2
        printf '  To update anyway (no new snapshot): system-update --no-snapshot\n' >&2
        ui_call snapshotFailed "${why:-snapper failed}"
        reported=1
        exit 3
    fi
    cat "$errf" >&2
    rm -f "$errf"
fi

say "pacman -Syu"
set +e
sudo pacman -Syu
pacman_rc=$?
set -e

say "recovery point"
if [ "$nosnap" -eq 0 ]; then root post "$pre" "$pacman_rc"; else echo "none taken for this update (--no-snapshot)"; fi

say "boot image check"
uki_ok=1
root ukicheck || uki_ok=0

say "repo-healthcheck (after, crashes since $(date -d @"$T0" +%T) count)"
health_ok=1
health --since "$T0" || health_ok=0

echo
if [ "$pacman_rc" -ne 0 ]; then
    echo "RESULT: pacman FAILED (exit $pacman_rc). The system may be partly updated."
elif [ "$uki_ok" -eq 0 ]; then
    echo "RESULT: updated, but the boot image looks WRONG - do not reboot before checking mkinitcpio's output above."
elif [ "$health_ok" -eq 0 ]; then
    echo "RESULT: updated, but repo-healthcheck FAILED (see above, details: repo-diagnose)."
else
    echo "RESULT: updated, healthy."
fi
if [ "$nosnap" -eq 1 ]; then
    echo "NOTE: NO new pre-update snapshot was taken for this update (--no-snapshot)."
    echo "      The newest \"Snapshot (before update)\" boot entry is the state before an EARLIER update."
else
    echo "Pre-update snapshot: $pre (boot menu: \"Snapshot (before update) ...\")."
fi
if [ "$pacman_rc" -ne 0 ] || [ "$uki_ok" -eq 0 ] || [ "$health_ok" -eq 0 ]; then
    echo "Nothing was rolled back. Your choices:"
    echo "  - fix it and run repo-healthcheck again"
    echo "  - reboot and pick \"Snapshot (before update) ...\" in the boot menu: test the old system, restore it from there"
    echo "  - sudo system-rollback $pre   (permanent, from the next boot on; /home stays)"
fi
if root rebootneeded "$T0"; then
    echo "A reboot is needed for the new kernel/system components (then: repo-healthcheck)."
fi
[ "$pacman_rc" -eq 0 ] && [ "$uki_ok" -eq 1 ] && [ "$health_ok" -eq 1 ]
