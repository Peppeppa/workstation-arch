#!/bin/bash
# Managed by Ansible (roles/recovery/files/snapshot-create) - do not edit by hand.
# Deployed to /usr/local/libexec/workstation/snapshot-create: the root helper
# behind OS menu -> System -> Create Snapshot (Quickshell SnapshotDialog,
# `pkexec <this> ...`, polkit action org.workstation.snapshot.create). Not a
# user interface. Exactly the three manual slots (snapshot-boot):
#
#   snapshot-create set <slot> <label>             into an EMPTY slot
#   snapshot-create set <slot> <label> <number>    overwrite: <number> is the
#                                                  snapshot the user confirmed;
#                                                  refused if the slot holds another
#   snapshot-create delete <slot> <number>         confirmed delete of that snapshot
#
# The label arrives as one argv element (no shell) and is validated again
# here - the dialog's own check is not trusted. Overwrite order (snapshot-boot):
# new snapshot -> it can boot -> slot moved -> old one deleted -> boot menu;
# any failure before the move leaves the slot as it was.
# Output (stdout, one JSON line) from snapshot-boot; errors on stderr, exit 1
# (2 = bad arguments).
set -euo pipefail

die() { echo "snapshot-create: $*" >&2; exit "${2:-1}"; }
SB=/usr/local/lib/workstation/snapshot-boot

[ "$(id -u)" -eq 0 ] || die "run through pkexec (root)"
slot_ok() { [[ $1 =~ ^[123]$ ]] || die "slot must be 1, 2 or 3" 2; }
num_ok() { [[ $1 =~ ^[0-9]+$ ]] || die "not a snapshot number: $1" 2; }

case ${1:-} in
set)
    [ $# -eq 3 ] || [ $# -eq 4 ] || die "usage: snapshot-create set <slot> <label> [<number>]" 2
    slot_ok "$2"; label=$3
    [ $# -eq 4 ] && num_ok "$4"
    # 1-100 bytes (UTF-8), printable only (shown in snapper lists and the
    # boot menu), never an option.
    LC_ALL=C
    [ -n "$label" ] || die "empty label" 2
    [ "${#label}" -le 100 ] || die "label longer than 100 bytes" 2
    case $label in -*) die "label must not start with '-'" 2 ;; esac
    if [[ $label =~ [[:cntrl:]] ]]; then die "label contains control characters (newline, tab, ...)" 2; fi
    unset LC_ALL
    if [ $# -eq 4 ]; then exec "$SB" slot-set "$2" "$label" --replace "$4"; fi
    exec "$SB" slot-set "$2" "$label"
    ;;
delete)
    [ $# -eq 3 ] || die "usage: snapshot-create delete <slot> <number>" 2
    slot_ok "$2"; num_ok "$3"
    exec "$SB" slot-delete "$2" "$3"
    ;;
*)
    die "usage: snapshot-create set <slot> <label> [<number>] | delete <slot> <number>" 2
    ;;
esac
