#!/usr/bin/nft -f
# Managed by Ansible (roles/firewall) - do not edit by hand.
# docs/feature-architecture.md "Firewall".
#
# Only the table `inet {{ firewall_table }}` is (re)created here - never
# `flush ruleset`: Docker's own tables (iptables-nft) live beside it and
# stay untouched. The three lines below replace this table atomically in
# one transaction (create-if-missing, delete, define).
table inet {{ firewall_table }}
delete table inet {{ firewall_table }}

table inet {{ firewall_table }} {
	# Every port rule (Settings -> Firewall: the factory rules DHCP, DHCPv6,
	# LocalSend, SSH and the user's own) lives in the chain repo_rules and,
	# for the user's rules, in these sets (Docker-published ports, forward) -
	# both filled ONLY by {{ firewall_helper }} from its rules.json, in the
	# same transaction that loads this file (`firewall-rules restore`
	# includes it). Empty here on purpose: no port is opened by this file.
	set share_tcp {
		type inet_service
	}

	set share_udp {
		type inet_service
	}

	chain repo_rules {
	}

	# Inbound to this host: default drop.
	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop

		# Docker containers -> host services (local bridges, only containers
		# sit on them).
		iifname "docker0" accept
		iifname "br-*" accept

		# ICMP errors that are not already `related`, IPv6 neighbor/router
		# discovery and MLD (IPv6 does not work without them). No echo
		# request: the machine does not answer pings on foreign networks.
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query } accept

		# The port rules (DHCP, DHCPv6, LocalSend, SSH, the user's) - see
		# repo_rules above.
		jump repo_rules
	}

	# Forwarded traffic: only NEW connections from outside towards Docker
	# containers are filtered here. Docker publishes a port (`-p 1234:80`)
	# with a DNAT in prerouting, so that traffic never reaches `input` -
	# it is decided here by the ORIGINAL (pre-DNAT) destination port: the
	# same share sets, the same semantics as for a host service.
	# Everything else forwarded (containers outbound, container <->
	# container, other forwarding) is not this table's business.
	chain forward {
		type filter hook forward priority filter; policy accept;

		ct state established,related accept
		iifname "docker0" accept
		iifname "br-*" accept
		oifname != "docker0" oifname != "br-*" accept

		meta l4proto tcp ct status dnat ct original proto-dst @share_tcp accept
		meta l4proto udp ct status dnat ct original proto-dst @share_udp accept
		drop
	}
}
