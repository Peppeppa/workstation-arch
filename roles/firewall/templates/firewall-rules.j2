#!/usr/bin/python3 -I
# Managed by Ansible (roles/firewall/templates/firewall-rules.j2) - do not
# edit by hand. docs/feature-architecture.md "Firewall".
#
# `firewall-rules` - the ONLY code that changes the user's LAN sharing
# rules (Settings -> Firewall). Runs as root: through
# `pkexec {{ firewall_helper }} ...` from Quickshell (polkit action
# {{ firewall_polkit_action }}: the active local session, no password) and
# as `restore` from workstation-firewall.service at boot.
#
# Its whole interface:
#   list                              JSON: the rules + whether each is live
#   add <label> <port> <protocol>     new rule, added DISABLED (nothing opens
#                                     until the user enables it)
#   enable|disable|remove <port> <protocol>
#   restore                           refill the nft sets from the state
#   status                            READ-ONLY JSON: what the kernel really
#                                     does with inbound traffic (below)
#
# A rule = (label, port 1-65535, TCP|UDP, enabled). Every argument is
# validated here; nothing from argv ever reaches nft except a validated
# port number and one of two fixed set names, and nft runs from an argv
# list, never a shell. The state ({{ firewall_state_dir }}/rules.json,
# root-owned, written atomically under a lock) is the desired list; the
# kernel sets share_tcp/share_udp in table inet {{ firewall_table }} are
# what is live - every change touches the kernel first and only then the
# state, and rolls the kernel back if the state cannot be written, so the
# two never disagree after a successful call.

import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import unicodedata

NFT = "/usr/bin/nft"
TABLE = "{{ firewall_table }}"
STATE_DIR = "{{ firewall_state_dir }}"
STATE = os.path.join(STATE_DIR, "rules.json")
LOCK = "/run/lock/workstation-firewall.lock"
RULESET = "{{ firewall_ruleset }}"
LABEL_MAX = 48
RULES_MAX = 64

# Ports the base ruleset already opens (system rules, not in the UI): a
# user rule for one of them could never really be disabled, so it is
# refused instead of shown as a switch that does nothing.
SYSTEM_PORTS = {
    ("TCP", {{ firewall_localsend_port }}): "LocalSend",
    ("UDP", {{ firewall_localsend_port }}): "LocalSend",
    ("UDP", 68): "DHCP",
    ("UDP", 546): "DHCPv6",
{% if ssh_server_enabled %}
    ("TCP", 22): "SSH",
{% endif %}
}


# Names for base rules - only where THIS host's configuration (roles/firewall
# + host capabilities) put the rule there, matched by the rule's exact shape;
# never a guess from a port number. (protocol, port) -> name
BASE_SERVICES = {
{% if ssh_server_enabled %}
    ("TCP", 22): "SSH (sshd, ssh_server_enabled)",
{% endif %}
    ("TCP", {{ firewall_localsend_port }}): "LocalSend (Dateiübertragung)",
    ("UDP", {{ firewall_localsend_port }}): "LocalSend (Geräteerkennung, Multicast)",
    ("UDP", 68): "DHCP (Adresse vom Router)",
    ("UDP", 546): "DHCPv6",
}


class Refused(Exception):
    """Invalid input or a request the rules do not allow (exit 1)."""


class Failed(Exception):
    """The firewall itself could not be changed or read (exit 2)."""


# ---- validation ------------------------------------------------------------

def parse_label(raw):
    label = raw.strip()
    if not label:
        raise Refused("Bezeichnung fehlt")
    if len(label) > LABEL_MAX:
        raise Refused(f"Bezeichnung zu lang (höchstens {LABEL_MAX} Zeichen)")
    if any(unicodedata.category(c)[0] == "C" for c in label):
        raise Refused("Bezeichnung enthält Steuerzeichen")
    try:
        label.encode("utf-8")
    except UnicodeEncodeError:
        raise Refused("Bezeichnung ist kein gültiger Text")
    return label


def parse_port(raw):
    # digits only, no sign/space/leading zero - nothing is "repaired"
    if not re.fullmatch(r"[1-9][0-9]{0,4}", raw):
        raise Refused("Port: eine Zahl von 1 bis 65535")
    port = int(raw)
    if port > 65535:
        raise Refused("Port: eine Zahl von 1 bis 65535")
    return port


def parse_protocol(raw):
    proto = raw.upper()
    if proto not in ("TCP", "UDP"):
        raise Refused("Protokoll: TCP oder UDP")
    return proto


# ---- state -----------------------------------------------------------------

def load():
    try:
        with open(STATE, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as e:
        raise Failed(f"{STATE} nicht lesbar: {e}")
    rules = data.get("rules") if isinstance(data, dict) else None
    if not isinstance(rules, list):
        raise Failed(f"{STATE} enthält keine Regelliste")
    out = []
    for r in rules:
        try:
            out.append({
                "label": parse_label(str(r["label"])),
                "port": parse_port(str(r["port"])),
                "protocol": parse_protocol(str(r["protocol"])),
                "enabled": r["enabled"] is True,
            })
        except (KeyError, TypeError, Refused) as e:
            raise Failed(f"{STATE} enthält eine ungültige Regel ({e})")
    return out


def save(rules):
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".rules.", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({"version": 1, "rules": rules}, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, STATE)
        dfd = os.open(STATE_DIR, os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise Failed(f"{STATE} nicht schreibbar: {e}")


def find(rules, port, proto):
    for i, r in enumerate(rules):
        if r["port"] == port and r["protocol"] == proto:
            return i
    return -1


# ---- kernel sets -----------------------------------------------------------

def set_name(proto):
    return "share_tcp" if proto == "TCP" else "share_udp"


def nft(*args):
    try:
        p = subprocess.run([NFT, *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Failed(f"nft: {e}")
    if p.returncode != 0:
        raise Failed("Firewall nicht geladen (workstation-firewall.service)"
                     if "No such file or directory" in p.stderr
                     else "nft: " + (p.stderr.strip().splitlines() or ["fehlgeschlagen"])[0])
    return p.stdout


def live(proto):
    try:
        out = json.loads(nft("-j", "list", "set", "inet", TABLE, set_name(proto)))
    except ValueError:
        raise Failed("unerwartete nft-Ausgabe")
    for item in out.get("nftables", []):
        if "set" in item:
            return {e for e in item["set"].get("elem", []) if isinstance(e, int)}
    raise Failed("unerwartete nft-Ausgabe")


def open_port(port, proto):
    nft("add", "element", "inet", TABLE, set_name(proto), "{ %d }" % port)


def close_port(port, proto):
    if port in live(proto):
        nft("delete", "element", "inet", TABLE, set_name(proto), "{ %d }" % port)


# ---- commands --------------------------------------------------------------

def cmd_list():
    rules = load()
    try:
        tcp, udp, loaded = live("TCP"), live("UDP"), True
    except Failed:
        tcp, udp, loaded = set(), set(), False
    for r in rules:
        r["active"] = r["port"] in (tcp if r["protocol"] == "TCP" else udp)
    print(json.dumps({"loaded": loaded, "rules": rules}, ensure_ascii=False))


def cmd_add(label, port, proto):
    label, port, proto = parse_label(label), parse_port(port), parse_protocol(proto)
    if (proto, port) in SYSTEM_PORTS:
        raise Refused(f"{proto} {port} ist immer offen ({SYSTEM_PORTS[(proto, port)]})")
    rules = load()
    if find(rules, port, proto) >= 0:
        raise Refused(f"Eine Regel für {proto} {port} gibt es schon")
    if len(rules) >= RULES_MAX:
        raise Refused(f"Höchstens {RULES_MAX} Regeln")
    # Added disabled: opening a port is always a separate, deliberate
    # "enable" - a typo in the dialog can never expose anything.
    rules.append({"label": label, "port": port, "protocol": proto, "enabled": False})
    save(rules)


def cmd_set(port, proto, enabled):
    port, proto = parse_port(port), parse_protocol(proto)
    rules = load()
    i = find(rules, port, proto)
    if i < 0:
        raise Refused(f"Keine Regel für {proto} {port}")
    if enabled:
        open_port(port, proto)
    else:
        close_port(port, proto)
    rules[i]["enabled"] = enabled
    try:
        save(rules)
    except Failed:
        # back to what the (unchanged) state says
        (close_port if enabled else open_port)(port, proto)
        raise


def cmd_remove(port, proto):
    port, proto = parse_port(port), parse_protocol(proto)
    rules = load()
    i = find(rules, port, proto)
    if i < 0:
        raise Refused(f"Keine Regel für {proto} {port}")
    close_port(port, proto)
    was = rules.pop(i)
    try:
        save(rules)
    except Failed:
        if was["enabled"]:
            open_port(port, proto)
        raise


def cmd_restore():
    rules = load()
    nft("flush", "set", "inet", TABLE, "share_tcp")
    nft("flush", "set", "inet", TABLE, "share_udp")
    for r in rules:
        if r["enabled"] and (r["protocol"], r["port"]) not in SYSTEM_PORTS:
            open_port(r["port"], r["protocol"])


# ---- status: the effective inbound state (read-only) -----------------------
# Nothing here changes the kernel: `nft -j list` for the live table, and the
# configured file loaded into a PRIVATE network namespace (`unshare -n`, its
# own empty netfilter) to compare what is persistent with what is live.

def nft_json(*args, ns=False):
    argv = ([UNSHARE, "-n", "--", "sh", "-c", 'nft -f "$1" && nft -j list ruleset', "sh", args[0]]
            if ns else [NFT, "-j", *args])
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Failed(f"nft: {e}")
    if p.returncode != 0:
        return None
    try:
        return json.loads(p.stdout).get("nftables", [])
    except ValueError:
        raise Failed("unerwartete nft-Ausgabe")


UNSHARE = "/usr/bin/unshare"


def fmt_value(v):
    """An nft JSON value -> text (addresses, prefixes, ranges, sets)."""
    if isinstance(v, (str, int)):
        return str(v)
    if isinstance(v, dict):
        if "prefix" in v:
            return "%s/%s" % (v["prefix"]["addr"], v["prefix"]["len"])
        if "range" in v:
            return "%s-%s" % tuple(fmt_value(x) for x in v["range"])
        if "set" in v:
            return ", ".join(fmt_value(x) for x in v["set"])
    if isinstance(v, list):
        return ", ".join(fmt_value(x) for x in v)
    return json.dumps(v)


def describe(expr):
    """One rule's expressions -> its conditions + verdict, as plain fields.
    Unknown conditions are kept verbatim in `other` (never dropped: a rule
    is shown narrower than it is only if we say so)."""
    r = {"proto": None, "ports": None, "set": None, "source": [], "dest": [],
         "iface": [], "family": None, "ct": None, "icmp": None, "other": [], "action": None}
    for e in expr:
        if "match" in e:
            m = e["match"]
            left, right, op = m.get("left", {}), m.get("right"), m.get("op", "==")
            neg = "nicht " if op == "!=" else ""
            if "meta" in left and left["meta"].get("key") in ("iif", "iifname"):
                r["iface"].append(neg + fmt_value(right))
            elif "meta" in left and left["meta"].get("key") == "l4proto":
                r["proto"] = fmt_value(right).upper()
            elif "payload" in left:
                pl = left["payload"]
                proto, field = pl.get("protocol"), pl.get("field")
                if proto in ("ip", "ip6") and field == "saddr":
                    r["source"].append(neg + fmt_value(right))
                    r["family"] = "IPv4" if proto == "ip" else "IPv6"
                elif proto in ("ip", "ip6") and field == "daddr":
                    r["dest"].append(neg + fmt_value(right))
                    r["family"] = "IPv4" if proto == "ip" else "IPv6"
                elif proto in ("tcp", "udp") and field == "dport":
                    r["proto"] = proto.upper()
                    if isinstance(right, str) and right.startswith("@"):
                        r["set"] = right[1:]
                    else:
                        r["ports"] = neg + fmt_value(right)
                elif proto in ("tcp", "udp") and field == "sport":
                    r["proto"] = proto.upper()
                    r["other"].append(f"{proto} Quellport {fmt_value(right)}")
                elif proto in ("icmp", "icmpv6") and field == "type":
                    r["icmp"] = fmt_value(right)
                    r["family"] = "IPv4" if proto == "icmp" else "IPv6"
                else:
                    r["other"].append(json.dumps(m, sort_keys=True))
            elif "ct" in left and left["ct"].get("key") == "state":
                r["ct"] = fmt_value(right)
            else:
                r["other"].append(json.dumps(m, sort_keys=True))
        elif "accept" in e:
            r["action"] = "accept"
        elif "drop" in e:
            r["action"] = "drop"
        elif "reject" in e:
            r["action"] = "reject"
        elif "jump" in e or "goto" in e:
            r["action"] = "jump " + json.dumps(e)
        elif "counter" in e or "log" in e:
            pass
        else:
            r["other"].append(json.dumps(e, sort_keys=True))
    return r


def canon(rule):
    return json.dumps([e for e in rule.get("expr", []) if "counter" not in e], sort_keys=True)


def chains_of(items, family, table):
    chains, rules, sets = {}, {}, {}
    for it in items or []:
        if "chain" in it and it["chain"]["family"] == family and it["chain"]["table"] == table:
            chains[it["chain"]["name"]] = it["chain"]
        elif "rule" in it and it["rule"]["family"] == family and it["rule"]["table"] == table:
            rules.setdefault(it["rule"]["chain"], []).append(it["rule"])
        elif "set" in it and it["set"]["family"] == family and it["set"]["table"] == table:
            sets[it["set"]["name"]] = it["set"]
    return chains, rules, sets


def set_elems(st):
    out = []
    for e in (st or {}).get("elem", []) or []:
        out.append(e if isinstance(e, int) else fmt_value(e))
    return out


def listeners():
    """TCP listeners and UDP sockets (ss), as {proto, addr, port, process, scope}."""
    out = []
    try:
        p = subprocess.run(["ss", "-H", "-ltnup"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    for line in p.stdout.splitlines():
        f = line.split()
        if len(f) < 5:
            continue
        local = f[4]
        addr, _, port = local.rpartition(":")
        addr = addr.strip("[]").split("%")[0]
        proc = re.search(r'"([^"]+)"', line)
        scope = ("lokal (Loopback)" if addr.startswith("127.") or addr == "::1"
                 else "alle IPv4-Adressen" if addr == "0.0.0.0"
                 else "alle IPv6-Adressen" if addr == "::"
                 else "alle Adressen" if addr == "*" else addr)
        try:
            out.append({"proto": f[0].upper(), "addr": addr, "port": int(port),
                        "process": proc.group(1) if proc else "", "scope": scope})
        except ValueError:
            continue
    return out


def connections(port):
    """Established inbound TCP connections to a local port: peer + interface."""
    try:
        p = subprocess.run(["ss", "-H", "-tn", "state", "established", f"( sport = :{port} )"],
                           capture_output=True, text=True, timeout=10)
        a = subprocess.run(["ip", "-j", "addr"], capture_output=True, text=True, timeout=10)
        ifaces = {}
        for i in json.loads(a.stdout or "[]"):
            for ai in i.get("addr_info", []):
                ifaces[ai.get("local")] = i.get("ifname")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return []
    out = []
    for line in p.stdout.splitlines():
        f = line.split()
        if len(f) < 4:
            continue
        local = f[2].rpartition(":")[0].strip("[]").split("%")[0]
        peer = f[3].rpartition(":")[0].strip("[]")
        out.append({"peer": peer, "iface": ifaces.get(local, "?")})
    return out


def cmd_status():
    live_items = nft_json("list", "ruleset")
    if live_items is None:
        raise Failed("Firewall-Zustand nicht lesbar (nft list ruleset)")
    conf_items = nft_json(RULESET, ns=True) if os.path.exists(RULESET) else None
    lchains, lrules, lsets = chains_of(live_items, "inet", TABLE)
    cchains, crules, _ = chains_of(conf_items, "inet", TABLE)
    loaded = "input" in lchains
    socks = listeners()
    try:
        saved = load()
    except Failed:
        saved = []
    labels = {(r["protocol"], r["port"]): r for r in saved}

    rules_out = []
    conf_canon = [canon(r) for r in crules.get("input", [])]
    live_canon = [canon(r) for r in lrules.get("input", [])]
    for rule in lrules.get("input", []):
        d = describe(rule["expr"])
        base_persist = "persistent" if conf_items is not None and canon(rule) in conf_canon else \
            ("unbekannt" if conf_items is None else "nur zur Laufzeit")
        entries = []
        if d["set"] in ("share_tcp", "share_udp"):
            for port in set_elems(lsets.get(d["set"])):
                saved_rule = labels.get((d["proto"], port))
                entries.append(dict(d, ports=str(port), origin="Freigabe (Einstellungen)",
                                    service=saved_rule["label"] if saved_rule else None,
                                    persistence="persistent" if saved_rule and saved_rule["enabled"] else "nur zur Laufzeit"))
        else:
            # a name only for a rule of the configuration itself
            service = None
            if base_persist == "persistent" and d["proto"] and d["ports"] and d["ports"].isdigit():
                service = BASE_SERVICES.get((d["proto"], int(d["ports"])))
            entries.append(dict(d, origin="Basis-Konfiguration" if base_persist == "persistent" else "nicht aus der Konfiguration",
                                service=service, persistence=base_persist))
        for x in entries:
            x["kind"] = "port" if x["ports"] else "infrastructure"
            if x["kind"] == "port" and socks is not None:
                try:
                    pnum = int(x["ports"])
                except ValueError:
                    pnum = None
                x["listening"] = [s for s in socks if s["proto"] == x["proto"] and s["port"] == pnum]
                x["connections"] = connections(pnum) if x["proto"] == "TCP" and pnum else []
            del x["set"]
            rules_out.append(x)
    # configured but not live (e.g. edited table)
    missing = [describe(r["expr"]) for r in crules.get("input", []) if canon(r) not in live_canon] if loaded else []
    for share in saved:
        if share["enabled"] and share["port"] not in set_elems(lsets.get("share_tcp" if share["protocol"] == "TCP" else "share_udp")):
            missing.append({"proto": share["protocol"], "ports": str(share["port"]), "service": share["label"]})

    # listening, but no accept rule for it (and not loopback-only)
    allowed = {(x["proto"], x["ports"]) for x in rules_out if x["kind"] == "port" and x["action"] == "accept"}
    blocked = [s for s in (socks or []) if s["scope"] != "lokal (Loopback)" and (s["proto"], str(s["port"])) not in allowed]
    local_only = [s for s in (socks or []) if s["scope"] == "lokal (Loopback)"]

    foreign = []
    for it in live_items:
        if "table" in it and not (it["table"]["family"] == "inet" and it["table"]["name"] == TABLE):
            t = it["table"]
            fch, frules, _ = chains_of(live_items, t["family"], t["name"])
            foreign.append({"table": f'{t["family"]} {t["name"]}',
                            "chains": [{"name": n, "hook": c.get("hook"), "policy": c.get("policy"),
                                        "rules": len(frules.get(n, []))} for n, c in fch.items() if c.get("hook")]})
    print(json.dumps({
        "loaded": loaded,
        "configured": conf_items is not None,
        "policy": lchains.get("input", {}).get("policy") if loaded else None,
        "inbound": rules_out,
        "missing": missing,
        "blocked": blocked,
        "localOnly": local_only,
        "listenersKnown": socks is not None,
        "foreign": foreign,
    }, ensure_ascii=False))


USAGE = ("usage: firewall-rules list | add <label> <port> <tcp|udp> | "
         "enable|disable|remove <port> <tcp|udp> | restore | status")


def main(argv):
    if os.geteuid() != 0:
        raise Refused("muss als root laufen (pkexec)")
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])
    table = {
        ("list", 0): cmd_list,
        ("restore", 0): cmd_restore,
        ("status", 0): cmd_status,
        ("add", 3): cmd_add,
        ("enable", 2): lambda p, q: cmd_set(p, q, True),
        ("disable", 2): lambda p, q: cmd_set(p, q, False),
        ("remove", 2): cmd_remove,
    }
    fn = table.get((cmd, len(args)))
    if fn is None:
        raise Refused(USAGE)
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        fn(*args)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Refused as e:
        print(f"firewall-rules: {e}", file=sys.stderr)
        sys.exit(1)
    except Failed as e:
        print(f"firewall-rules: {e}", file=sys.stderr)
        sys.exit(2)
