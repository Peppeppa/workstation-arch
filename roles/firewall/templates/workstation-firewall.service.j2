# Managed by Ansible (roles/firewall) - do not edit by hand.
# Loads the table `inet {{ firewall_table }}` and the port rules (rules.json)
# in ONE nft transaction (`firewall-rules restore` includes the ruleset
# file); then exits (oneshot) - the kernel does the filtering, no
# process stays. Ordered like Arch's nftables.service (before the network
# comes up), but never `flush ruleset`.
[Unit]
Description=Workstation firewall (nftables table inet {{ firewall_table }})
Documentation=file://{{ firewall_ruleset }}
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no
# the port rules (firewall-rules restore) live there
RequiresMountsFor={{ firewall_state_dir }}

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=null
ProtectSystem=full
ProtectHome=true
ExecStart={{ firewall_helper }} restore
ExecReload={{ firewall_helper }} restore
ExecStop=/usr/bin/nft delete table inet {{ firewall_table }}

[Install]
WantedBy=sysinit.target
